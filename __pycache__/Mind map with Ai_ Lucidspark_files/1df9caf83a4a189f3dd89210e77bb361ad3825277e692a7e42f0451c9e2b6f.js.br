replaySequence:0},Ue:Uchyk},{Re:{id:"cf625697-18bb-4879-ab3e-b6409c73d254",name:"ServiceNow Sourced",shortName:null,description:"",mode:"SINGLE",restrictToFactSheetTypes:["ITComponent"],mandatoryForFactSheetTypes:[],replaySequence:0},Ue:Uchyk}],Gg:[]};var Ucjyk=[Ucdf.uKa,Ucdf.afa,Ucdf.uwa,Ucdf.zoa,Ucdf.nAa,Ucdf.o7,Ucdf.jsa,Ucdf.Tha,Ucdf.gfa,Ucdf.Wha,Ucdf.Csa,Ucdf.Dsa,Ucdf.Moa,Ucdf.DAa,Ucdf.Strategy,Ucdf.Mvb,Ucdf.jG],Uckyk=[Ucdf.aAh,Ucdf.i4a,Ucdf.JKa];var Uclyk=new Map([[UcDe.T4,{title:i18n.get("pull-request-review-title-approved"),Ova:i18n.get("pull-request-review-subheading-approved"),dtm:i18n.get("pull-request-review-confirm-approved-v2")}],[UcDe.Yha,{title:i18n.get("pull-request-review-title-needs-work-v2"),Ova:i18n.get("pull-request-review-subheading-needs-work-v2"),dtm:i18n.get("pull-request-review-confirm-needs-work-v2")}]]);var Ucmyk={zg:Ucxd.NNf,Bl:!0,Woc:!1,description:"## Role\n\nPackages user-provided text content into a .txt file and adds it to the process context frame. The file contents are automatically extracted from the most recent user message — you only need to provide a file name.\n\n## When to Use\n\n- The **most recent user message** contains structured or substantial text content that will be used for diagram generation — this includes process specs, flow definitions, SOPs, procedures, workflows, step lists, or any structured data describing a process\n- The content is **proactively shared** by the user as reference material, not a reply to a question you asked\n\n## When NOT to Use\n\n- Content is a **short reply or answer** to a question you asked\n- Content is clearly **unrelated to the process**\n- User **explicitly states** the content is not for process documentation\n- The relevant content is from an **earlier message**, not the most recent one\n\n## Key Behaviors\n\n- **Always call this tool before any content generation tools** (e.g., GenerateDiagram, CreateDiagramOutline) to persist context first\n- When uncertain, **err on the side of adding** — missing context is worse than adding extra, since users can always delete unwanted context\n- Can be called **alongside other tools** (not a terminator)\n"};var Ucnyk={zg:Ucxd.QNf,Bl:!0,Woc:!1,description:"**Add Chat Notes to Process Context Frame Tool**\n\nRecords clarifications and chat notes about the process to the process context frame on the document.\n\n**When to Use:**\n- ALWAYS call this tool after the user responds to AskClarifyingQuestions tool. Only include questions the user explicitly answered — skip vague or ambiguous responses.\n- When the user provides important context or clarifications about the process.\n\n**When NOT to Use:**\n- For general conversational responses that do not resolve a specific ambiguity about the process.\n- When the user is asking a question rather than providing an answer.\n- When the chat note (or a semantically equivalent one) already exists in the context frame.\n\n**Key Behaviors:**\n- Rephrase chat notes to third-person — the Q&A is visible to all document collaborators.\n- Be concise. 1 question and 1 answer per chat note. Split up complex chat notes into multiple simpler ones if needed.\n- Check existing chat notes in the context frame (### Context Frame Content -> #### Chat Notes section in the system prompt) to avoid duplicate chat notes.\n- Can be called alongside other tools (not a terminator).\n- Multiple chat notes can be added in a single call.\n"};var Ucoyk={zg:Ucxd.RNf,Bl:!0,Woc:!1,description:"## Role\n\nAdds uploaded files to the persistent process context frame on the document, making them part of the permanent process documentation.\n\nWhen to Use:\n- When user uploads files clearly containing **process-related content** (SOPs, procedures, templates, workflows, documentation, guidelines, steps) meant for process documentation\n- When user uploads images that are **clearly process-related** (photos of whiteboards, diagrams, flowcharts, screenshots of tools or processes) meant for process documentation\n- When user **states clearly** to add uploaded files as part of the process documentation\n\n## When NOT to Use\n\n- Files uploaded only for **one-off questions** (no intent to document)\n- Files clearly **unrelated to the process** (personal files, photos, test data)\n- User **explicitly states** file is NOT part of process documentation\n- **No files** have been uploaded yet\n\n## File Reference Format\n\n- Files in conversation history have references in the format `{uuid}_{index}` (e.g. `cdf46ea1-3bda-4df7-a244-36222ebf9aef_0`)\n- All files have their respective reference as a header in the message content (e.g. `[File Reference: cdf46ea1-3bda-4df7-a244-36222ebf9aef_0]`)\n- File references are **unique** across the whole conversation\n\n## Key Behaviors\n\n- **Always call this tool proactively** if the above criteria is met — call before AskClarifyingQuestionTool or any other tool to ensure files are added to context before any other operations\n- When uncertain, **err on the side of adding** — duplicates are auto-skipped and users can remove them if irrelevant\n- Added files **persist across sessions** and become permanent blocks on the context frame\n- **Audio/video files** are stored as transcript text files (e.g. `recording.mp3` becomes `recording_transcript.txt`) — the original binary is not stored\n- **Automatic duplicate detection** based on file content — duplicates are skipped\n- Can be called **alongside other tools** (not a terminator)\n- The tool outputs which files were **added** and which were **skipped** (duplicates or invalid references)\n- Only available **after switching to the process agent** — consider adding files before the process agent was active if they meet criteria\n- **Evaluate each file reference separately** — do not batch-assume all should be added/skipped\n- Users can **remove files** from the context frame, so re-add if a deleted file is re-uploaded or specifically referenced — but be cautious about re-adding to avoid frustrating the user\n"};var Ucpyk={zg:Ucxd.SNf,Bl:!1,description:["## Role\nUse this tool to add existing canvas blocks onto an existing Lucid timeline.\n\n## Prerequisites\n- The blocks must already exist on the canvas (e.g., created via ImportJiraToBoard or AddBlock).\n- A timeline must already exist — Use the CanvasQuery tool to discover this timeline, and if there are none, use the CreateLucidTimeline tool.\n\n## Capabilities\n- Places existing blocks onto a specific timeline as tasks\n- Handles date processing automatically for blocks with or without date fields\n\n## Usage Guidelines\n- Use the generatorId returned by the CreateLucidTimeline tool\n- Use block IDs returned by other tools such as ImportJiraToBoard or AddBlock\n- Call this AFTER both the blocks and the timeline have been created\n\n## Limitations\n- Does not create blocks or timelines — use other tools for that\n- Only works with timeline generators, not other generator types"]};var Ucqyk={zg:Ucxd.UUb,Bl:!0,description:'## Role\n\nThis is your primary tool for *reading* and *querying* the canvas or document. It retrieves items from the canvas based on your query criteria and returns their JSON representation with the properties you request.\n\n## How It Works\n\nThis tool uses a **two-stage filtering pipeline**:\n\n1. **Deterministic Filters** (*TextPattern*, *ColorSearch*, *ShapeTypes*, *Regions*, *User Viewport) — rule-based filters that narrow results precisely; all active filters are combined with **AND logic** (items must satisfy *every* specified filter)\n2. **AI Semantic Search** (via *SelectionCriteria*) — an AI subagent interprets your natural language description and further refines results; use this when the query involves open-ended categories or concepts that deterministic filters cannot express. Leave SelectionCriteria empty when deterministic filters are sufficient — deterministic filters are faster and more precise\n\nAfter both stages, an optional **Proximity Expansion** (*ItemsInProximity*) can include nearby items for additional context.\n\nYou also control **which properties** appear in the output via *BlockProperties*, *LucidCardBlockProperties*, and *LineProperties*. Only request the properties you need to keep the response focused.\n\n## General Usage Guidelines\n\n- These are general guidelines; follow any system prompt instructions you have as to how to use this tool first.\n- Only use this tool when the existing context, conversation history, and previous tools\' outputs are NOT sufficient.  Many times they will be, including IDs of new blocks, and status updates.\n- This tool returns raw JSON data; not summaries, takeaways, or generalizations.\n- Do **NOT** use this tool to discover the exact result of a delete command that utilized \'healConnections\' unless it is ABSOLUTELY VITAL to your immediate task.\n- Default to using only the Deterministic filters whenever possible - they are much faster than selection criteria.\n- Use no deterministic filters or selection criteria to read everything about the document.  Again, this should be rare.\n\n## Examples\n\n### Basic: Find items by text\n> User says "I need to finish up the items marked TODO before our sprint review"\n- **TextPattern**: "TODO"\n- **SelectionCriteria**: "" (deterministic filter is sufficient)\n\n### Semantic: Meaning-based query\n> User says "Help me prepare for our architecture review — what are the key decision points in this workflow?"\n- **SelectionCriteria**: "main decision points in the workflow"\n- **Why**: "Decision point" is a semantic concept — a shape might be labeled "Approve?" or "Route A vs B" without literally containing the word "decision". No regex alternation pattern can reliably capture this because it requires understanding the shape\'s *role* in the workflow, not just its text.\n\n### Filter by user viewport\n> User says "Can you walk me through this diagram?", while they have nothing selected on the canvas.\n- **FilterToUserViewport**: true\n- **Why**: The user asked for a walkthrough of a specific diagram, but provided no additional context to narrow down which diagram they are talking about.  It is likely that they are looking at a specific portion of the canvas and want to understand what it is they are looking at.\n\n### Multiple filters: text + proximity\n> User says "I\'m checking what might be blocked — show me what\'s near the shapes that mention deadlines or due dates"\n- **TextPattern**: "deadline|due date|due by|overdue|timeline"\n- **ItemsInProximity**: 15\n- **SelectionCriteria**: ""\n- **Why**: Regex finds deadline-related shapes, then proximity expansion pulls in their neighbors for context.',
Fga:i18n.get("ai-tool-loading-reading-canvas")};var Ucryk={zg:Ucxd.W4,Bl:!1,description:'This tool converts existing shapes on the canvas from one type to another. Use this tool when the user wants to transform, convert, or change the type of shapes.\n\n## IMPORTANT: Check canBeChangedTo First\nBefore using this tool, query the target blocks with CanvasQuery and request the "CanBeChangedTo" block property. This property lists valid target shape types for each block. Shape changes ONLY work within exchange groups - you cannot convert a shape to an arbitrary type.\n\nIf the user\'s requested target shape is NOT in the block\'s canBeChangedTo list, DO NOT use this tool.\n\n## When to Use\n- User asks to convert shapes to a different type AND the target is in canBeChangedTo\n- User wants to transform shapes while preserving content and position\n- The target shape type is a valid exchange within the same group\n\n## When NOT to Use\n- Target shape type is NOT in the block\'s canBeChangedTo list (use delete + create instead)\n- User wants to create new shapes (use AddBlock instead)\n- User wants to change visual properties like color or size (use EditItem instead)\n\n## Examples\n- "Turn these flowchart shapes into different flowchart shapes" -> Check canBeChangedTo, use this tool if valid\n- "Convert sticky notes to process blocks" -> Likely NOT in canBeChangedTo, use delete + create approach\n- "Change these rectangles to circles" -> Check canBeChangedTo first'};var Ucsyk={zg:Ucxd.c9,Bl:!0,description:'## Role\n\nProduces highly targeted, specification-driven summaries of a large canvas/document by operating on spatial chunks.\n\n## Critical Requirement — additionalPrompt Usage\n\n- **General summarization:** Leave additionalPrompt *empty* — the tool will use appropriate defaults based on selection\n- **Filtered summarization:** Provide specific filtering instructions in additionalPrompt, e.g., "Locate and summarize all error-related content"\n\n## How It Works\n\n- The overall document is split into **spatially/semantically coherent chunks**\n- This tool is called **once per chunk** with your summary instructions\n- For each chunk, it extracts only information that **matches your request** and returns a dense, factual summary\n- Chunks with **no relevant information** are effectively ignored, so unrelated content does not pollute the final result\n- Outputs are optimized for **tool-to-tool communication** — compact, information-dense, and free of visual/styling noise\n\n## Selection Handling\n\nThe tool automatically detects what to summarize:\n- **Shapes selected** → summarizes only those selected shapes\n- **No shapes selected** → summarizes the entire document\n\n## Behavior Guarantees\n\n- Focuses on **content, not presentation** — ignores styling, coordinates, fonts, and colors unless they carry explicit semantic meaning (e.g., colors encode status or type)\n- **Strict about relevance** — if a chunk does not clearly match your requested topics and include criteria, it returns no effective summary for that chunk\n- Resulting chunk summaries are:\n  - **Dense, factual, and faithful** to the underlying diagrams and notes\n  - **Easy to merge** into a final, document-level summary by a coordinating tool\n\n## When to Use\n\n- When the user specifically asks for a **summary of the document** or a piece of it — *the user must be referring to document contents, as this tool only works on the current document*\n- When the user asks something that implies wanting a summary, like:\n  - "Tell me about this diagram"\n  - "What is this mindmap about?"\n- When the user asks for tasks, action items, to-dos, assignments, next steps, or a checklist based on the document content\n  - "Give me some tasks based on this board"\n\n## When NOT to Use\n\n- When the user asks for a summary of **anything other than document contents**\n  - If the user wants to summarize a file they uploaded, text they pasted, or anything else not on the document — message the user a summary manually instead\n',
Fga:i18n.get("ai-tool-loading-summarizing")};var Uctyk={zg:Ucxd.vO,Bl:!1,description:"## Role\n\nHelp users apply, modify, or remove conditional formatting rules on the canvas. You are **not** able to delete any rules.\n\n## Capabilities\n- The system can format shapes based on almost any criteria that can be determined from looking at the canvas.\n- The system can apply the following visual effects: **background color**, **border color**, **text color**, or a predefined **shape style** or **icon**.\n- If the user's request falls outside these capabilities, the rule **cannot** be created.\n- As a general policy, after you've clarified requirements you should submit requests to the conditional formatting tool even if you're not sure it can be accomplished.\n- If the tool can't complete the request, it will return an error message explaining why - which you may be able to use to try again or explain to the user.\n- If the tool can't complete the request the first time, you should almost always try again with isComplex set to true, which allows for more complex logic and conditions. However, even with isComplex set to true, there are still limitations to what conditional formatting rules can do (e.g., they still can't analyze semantic content).\n\n## Interaction Guidelines\n\n- Before making changes, **always clarify** which shapes the user wants to edit — ask the user to specify verbally; if unclear, prompt them to manually select the shapes\n- If the request is vague, **ask for more context** about the desired changes\n- **Always explain** what conditional formatting changes will be applied\n- Maintain a **friendly, collaborative, and action-oriented** tone\n- Provide a **short (2-5 word) descriptive title** that will be used as the title of the generated or updated rule\n- If the user requests a specific title, you **must** include that rule name so the tool will use it\n- If the user requests to **delete** a rule, inform them that you are unable to do so\n- If the request combines **multiple effects** with **different conditions** (e.g., \"make shapes with 'High' red and shapes with 'Low' green\"), break these into **separate commands**, each with its own title, condition, and effect\n\n## Editing Existing Rules\n\n- In order to edit a rule, you must include the rule ID to be edited in the RuleIdToEdit field\n- You can get the rule ID to edit from the list of already-created rules in conversation history, or from the user message directly.\n- Users are not aware of rule IDs or the existence of rule IDs — ask them to **select from the list** of already-created rules in conversation history by name. Never ask the user for a rule ID directly.\n- If the user is editing an existing rule, forward their request to the tool - you cannot see the details of the existing rule, but the subagent can. The user does not need to describe the entire condition and effect when editing.\n- If the user is trying to edit a **deleted rule**, inform them\n- **One rule per command** — do not attempt to edit multiple rules in a single command\n\n## Technical Details\n\n- Applies deterministic rules globally to all shapes (e.g., based on value of shape text, shape data, shape type, connections to other shapes, which container it belongs to, and more).\n- If the user's request asks for multiple rules to be created, you MUST create multiple conditional formatting commands. One conditional formatting command CANNOT and MUST NOT have multiple formatting rules attached to it. Each rule must be its own command.",
Fga:i18n.get("ai-tool-loading-updating-rules")};var Ucuyk={zg:Ucxd.MRf,Bl:!1,description:"## Role\nCopies or duplicates **existing** items that are already on the canvas.\nThis tool requires item IDs and preserves all intrinsic properties such as text, color, or size from the originals (does not preserve emoji reactions or comments).\n\n## When to Use This Tool\n- To duplicate existing items while preserving their properties\n- To copy items into a different container or location\n- To move items by copying then deleting the originals\n\n## When NOT to Use This Tool\n- To create *new* items — use *AddBlock* instead\n- When you don't have valid item IDs to copy\n\n## Placement Guidelines\n- **Pasting into a diagram/container**: Use `assistedLayoutPlacement` with the container's ID and optionally `row`/`column`. Using X/Y coordinates will place items *outside* the container.\n- **Pasting on empty canvas**: Use X/Y coordinates or omit placement for default offset behavior."};var Ucvyk={zg:Ucxd.Hk,Bl:!1,description:"## Role\n\nCreate a single new block on the canvas with only class, variant, position, and size. Does NOT set colors, text, card data, or other properties — use the dedicated EditBlock* sub-tools for those after creation.\n\n## When to Use\n- Adding a new block, shape, or frame to the canvas.\n- If you don't already know the className, use ShapeLibraryTool to search, then ShapeDetailsTool for variants and advanced properties.\n\n## Custom Shape Libraries\n- ShapeLibraryTool may return shapes from user-created custom libraries (libraryId starting with `custom:`). For those, pass the shape's identifier as `customShapeUri` here. Do NOT also pass `library` or `variant` — those are for standard libraries only. The tool resolves the underlying class (including FreehandBlock for hand-drawn custom shapes) and applies the library's stored geometry/stencil automatically.\n\n## Rules\n- Emit one call per block. To create multiple blocks, emit multiple parallel tool calls.\n- The tool returns the newly-created blockId in its result; reuse that ID in any follow-up EditBlock* calls."};var Ucwyk={zg:Ucxd.zRe,Bl:!1,description:'This tool creates a diagram key (legend block) that shows the unique shape types used in a specified diagram container.\n\n## When to Use\n- The user asks for a diagram key, legend, or shape key for an existing diagram\n- The user wants a visual summary of the shapes used in their diagram\n- Examples: "Create a key for this diagram", "Add a legend showing what each shape means"\n\n## Input\n- diagramId: The container block ID of the diagram to create a key for'};var Ucxyk={zg:Ucxd.pod,Bl:!1,Woc:!1,description:"**Create Diagram Outline Tool**\n\nConverts an existing diagram into a structured SOP (Standard Operating Procedure) outline and places it as a block on the canvas.\n\n**When to Use:**\n- When the user wants a text-based procedure document on the canvas (often called an SOP or Diagram Outline).\n\n**Requirements:**\n- A diagram must be present on the canvas.\n- The diagramId parameter must be the ID of a container surrounding the diagram. The container ID returned by the GenerateDiagram tool can be used for this purpose.\n"};var Ucyyk={zg:Ucxd.URf,Bl:!1,description:['## Role\nUse this tool to create a new dynamic table on the canvas. A dynamic table is a grid-based visualization with customizable row and column headers that can hold cards and data-backed items. It is different from a static table — dynamic tables support grouping, filtering, and syncing with external data sources like Jira.\n\nIf the user asks for "a table" without specifying "dynamic table", you should still use this tool — dynamic tables are the standard table type in Lucid.\n\n## Capabilities\n- Create a new empty dynamic table on the current page\n- By default, creates a blank 2x2 table with empty headers\n- Optionally specify custom row and/or column labels when the user explicitly requests them\n\n## Usage Guidelines\n- If the user just asks for a table without specifying rows/columns, omit both parameters to create a blank 2x2 table\n- Only provide row/column labels when the user explicitly names them (e.g. "rows should be Sprint 1, Sprint 2")\n- After creating it, ask the user "Do you want me to import cards from an integration like Jira" but do not ask for any jira details until they confirm.\n## Response Guidelines\n- The Generator ID returned by this tool is for internal use only — do not mention it to the user\n\n## Limitations\n- Cannot modify existing tables — this tool only creates new ones\n- Creates an empty table — cards or items must be added separately by the user']};var Uczyk={zg:Ucxd.KU,Bl:!1,description:"## Role\n\nCreate a single connector (line/arrow) between two endpoints. Each endpoint may be pinned to a block or to an absolute (x, y) canvas position, with optional endpoint style (e.g. arrow shape).\n\n## When to Use\n- Connecting two blocks with a line or arrow.\n- Drawing a free-floating connector between two canvas coordinates.\n\n## Rules\n- Emit one call per connector. To create multiple connectors, emit multiple parallel tool calls.\n- Either (BlockId) or both (X, Y) must be provided on each endpoint."};var UcAyk={zg:Ucxd.VRf,Bl:!1,description:["## Role\nUse this tool to create a new Lucid timeline visualization on the canvas.\n\n## Capabilities\n- Create a new timeline visualization on the Lucid canvas with a specified date range\n- Uses the specified time unit (days, weeks, sprints, months, or quarter) regardless of the date range\n\n## Usage Guidelines\n- Provide start and end dates in ISO 8601 format (YYYY-MM-DD)\n- Provide a time unit (days, weeks, sprints, months, or quarter). This unit should be specified from the user.\n- The end date must be after the start date\n\n## Limitations\n- Cannot modify existing timelines — this tool only creates new ones\n- Creates an empty timeline — items must be added separately"]};var UcByk={zg:Ucxd.CRe,Bl:!1,description:"**Create Process Header Tool**\n\nCreates a formatted header block for a process diagram containing the process title, owner, last updated date, and scope description.\n"};var UcCyk={zg:Ucxd.Lyc,Bl:!1,description:'## Role\n\nDeletes items (shapes, sticky notes, lines, etc.) from the canvas.\n\nNo lines or other shapes are affected by these deletions unless the healConnections flag is on, in which case the system attempts to bridge the gaps left by the deleted blocks automatically.\n\n## Examples of user requests that indicate this tool should be used\n- "Delete the sticky note"\n- "Clear the items"\n\n## Heal Connections Behavior\n\nWhen `healConnections` is enabled, the system automatically bridges gaps by connecting each predecessor of the deleted block to each successor. This works transitively — if you delete a consecutive chain of nodes, predecessors are connected all the way through to the first surviving successor. You can **predict the resulting connections** from the current Lymtex without needing to re-query the canvas:\n- If A→B→C, deleting B with heal creates A→C\n- If A→B→C→D, deleting B and C with heal creates A→D\n- If A→B and C→B and B→D, deleting B with heal creates A→D and C→D'};var UcDyk={zg:Ucxd.vSe,Bl:!1,description:"## Role\n\nSet a single shape-specific advanced property on one block (for example, the number of fields on an ERD entity, or a table's column count).\n\n## When to Use\n- Changing a dynamic, shape-specific property that's declared in the shape's advancedPropertyDescriptors.\n- Discover valid property names and value types first with ShapeDetailsTool.\n\n## Rules\n- Emit one call per (block, property) pair. To change several advanced properties, emit multiple parallel tool calls.\n- Provide valueType only when the shape's descriptor requires it."};var UcEyk={zg:Ucxd.wSe,Bl:!1,description:"## Role\n\nUpdate LucidCard-specific data fields on a single card block: Title, Description, Status, Owner, Estimate, StartTime, EndTime.\n\n## When to Use\n- Changing a card's title, description, or any of its structured fields.\n- Setting or changing a card's status, owner, estimate, or date range.\n\n## Rules\n- Dates must be ISO 8601 (e.g. \"2024-01-15\").\n- Emit one call per card. To edit multiple cards, emit multiple parallel tool calls.\n- Only fields you want to change need to be set; omit the rest."};var UcFyk={zg:Ucxd.xSe,Bl:!1,description:"## Role\n\nUpdate the visual style of a single existing block: FillColor, LineColor, LineWidth, and StrokeStyle.\n\n## When to Use\n- Changing fill or border color of a block.\n- Changing border width or stroke style (solid, dashed, dotted) of a block.\n\n## Rules\n- Emit one call per block. To restyle multiple blocks, emit multiple parallel tool calls.\n- Only fields you want to change need to be set; omit the rest."};var UcGyk={zg:Ucxd.jUf,Bl:!1,description:"This tool edits the most recently generated board layout.\n\n## Requirements\n- A board MUST have been previously generated with the TextToBoard tool in this session.\n- If no prior board exists, this tool will return an error.\n\n## When to use this tool\nUse this tool when the user wants to make changes to a board that was just generated with TextToBoard.\n\n## When NOT to use this tool\n- Do NOT use this tool if no board has been generated yet — call TextToBoard first.\n- Do NOT use this tool to create a completely new board — use TextToBoard instead.\n\n## After using this tool\n- State what was changed in a single sentence.\n- Do NOT ask follow-up questions or suggest next steps unprompted.",
Fga:i18n.get("ai-tool-loading-generating-board")};var UcHyk={zg:Ucxd.kUf,Bl:!1,description:['## Role\nUse this tool to modify the settings of an existing dynamic table after it has been created.\n\n## Prerequisites\n- The dynamic table must already exist — use the generatorId of the dynamic table on the canvas.\n\n## Capabilities\n- Enable or disable agile capacity planning\n- Toggle load tracking graphic visibility\n- Set row and column pivots (grouping fields) to organize data by assignee, status, priority, or custom fields\n\n## Usage Guidelines\n- Use the generatorId from an existing dynamic table on the canvas\n- Only provide the fields you want to change — omit other fields to keep them unchanged\n- For pivots, use semantic field names for standard fields: "user" (assignee), "status", "priority", "parent", "estimate", "project", "issuetype", "reporter", "sprint", "team"\n- For visual grouping (always available): "fillcolor", "linecolor", "emojis", "tags"\n- For custom fields, use the exact field name from the data source\n- Standard fields are only available if the table\'s data source includes that field — if a field is unavailable, the tool returns an error listing valid options\n- Set a pivot field to "none" to remove that grouping\n- At least one pivot (row or column) must remain defined — both cannot be "none"\n\n## Limitations\n- Cannot create a new dynamic table — use the appropriate creation tool for that\n- Cannot add or remove individual cards from the dynamic table\n- Cannot modify individual card properties — use the EditItem tool for that\n- Cannot create or update Jira sync configurations — use the SyncJiraToDynamicTable tool for that']};var UcIyk={zg:Ucxd.nUf,Bl:!1,nRb:!0,description:"## Role\n\nEdits structured data field values on integration-synced cards (e.g. ADO, Jira, or extension API cards).\nChanges are automatically synced back to the external system.\n\n## When to use\n\nUse when the user wants to modify any data field values on integration-synced cards — title, summary, status, assignee, priority, dates, description, custom fields, or any other field reported by ReadCardData.\nAlways call ReadCardData first to discover field names, current values, types, enum options, and locked status.\n\n## When NOT to use\n\nDo NOT use for visual properties (color, size, position, text styling) — use EditItem instead.\nDo NOT use for non-card shapes that have no data schema.\nDo NOT use for generic Lucid cards that are not synced with an external integration.\n\n## Field names\n\nUse the field `name` (not `label`) from ReadCardData output.\nFor enum fields, provide the display name string — the tool resolves it to the correct ID via the integration.\n\n## Locked fields\n\nReadCardData reports which fields are locked. Do not attempt to edit locked fields — the tool will skip them and report them as not editable.\n\n## Jira status fields\n\nThis tool cannot change the status field on Jira cards. Jira requires workflow transitions to change status, which this tool does not support. If the user asks to change a Jira card's status, let them know they need to change it manually via the status field on the card or in Jira directly."};var UcJyk={zg:Ucxd.ySe,Bl:!1,description:'## Role\n\nRewire or restyle a single endpoint (endpoint1 or endpoint2) of an existing line: connect to a new block, move to an absolute position, or change the endpoint style (arrow shape).\n\n## When to Use\n- Reconnecting one end of a line to a different block.\n- Pinning one end of a line to a specific (x, y) canvas position.\n- Changing the arrow style at one end of a line.\n- Any combination of the above in a single call — e.g. rewiring to a block while also changing the arrow style.\n\n## Rules\n- Endpoint must be "endpoint1" or "endpoint2".\n- Provide BlockId (with optional LinkX/LinkY) OR both X and Y to change geometry. Style can be provided on its own or together with a geometry change.\n- Emit one call per endpoint. To move both endpoints, emit two parallel tool calls.'};var UcKyk={zg:Ucxd.zSe,Bl:!1,description:"## Role\n\nSet a single LineStyle property on one existing line: LineColor, LineWidth, StrokeStyle, or LineShape.\n\n## When to Use\n- Recoloring a connector.\n- Changing a connector's width, stroke pattern (solid/dashed/dotted), or routed shape.\n\n## Rules\n- Emit one call per (line, style) pair. To set multiple styles on a line, emit multiple parallel tool calls.\n- Value formatting follows LineStyle: hex for LineColor, numeric string for LineWidth, enum string for StrokeStyle and LineShape."};var UcLyk={zg:Ucxd.BSe,Bl:!1,description:"## Role\n\nEdit a single text area on either a block or a line (connector label). Supports updating the text, alignment (blocks only), and character/whole-text formatting.\n\n## When to Use\n- Changing the text inside a named text area on a block or line.\n- Bolding/italicizing/coloring text in an existing text area.\n- Setting text alignment (left/center/right/top/middle/bottom) on a block's text area.\n\n## Rules\n- textAlign/textVAlign apply only to blocks and are ignored when the target is a line.\n- Emit one call per (itemId, textAreaName). To edit multiple text areas, emit multiple parallel tool calls."};var UcMyk={zg:Ucxd.rUf,Bl:!1,description:['## Role\nUse this tool to modify the settings of an existing Lucid timeline after it has been created.\n\n## Prerequisites\n- The timeline must already exist — use the generatorId returned by the CreateLucidTimeline tool.\n\n## Capabilities\n- Change the timeline\'s date range (start date, end date, or both)\n- Change the timeline unit (days, weeks, sprints, months, or quarter)\n- Enable or disable capacity planning\n- Set a uniform capacity value for all time periods (e.g., story points per sprint)\n- Toggle weekend highlighting\n- Toggle the today marker\n- Map data fields from imported items (e.g., Jira issues) to the timeline\'s start and end dates\n- Configure row grouping (e.g., group by assignee, status, priority, or a custom field)\n\n## Usage Guidelines\n- Use the generatorId returned by the CreateLucidTimeline tool\n- Only provide the fields you want to change — leave other fields as empty strings\n- If changing dates, provide them in ISO 8601 format (YYYY-MM-DD)\n- Enabling capacity planning will automatically switch the unit from days to weeks if currently set to days\n- To set capacity values, capacity planning must be enabled first — if not already enabled, set EnableCapacityPlanning to "true" in the same call\n- For date field mapping, use the exact field name from the imported data source (e.g., "Start date", "Due date" for Jira fields)\n- Date field mapping should be done AFTER importing items onto the timeline with the SyncJiraToTimeline tool\n- If the field name is not found, the tool will return an error listing the available field names\n- For row grouping, use semantic names like "user", "status", "priority" for standard fields, or exact field names for custom fields\n- Set RowGroupByField to "none" to remove row grouping\n\n## Limitations\n- Cannot create a new timeline — use CreateLucidTimeline for that\n- Cannot add or remove items from the timeline — use SyncJiraToTimeline for importing Jira issues\n- Cannot change the cards that are on the timeline']};var UcNyk={zg:Ucxd.JSe,Bl:!0,description:'## Role\n\nExports and downloads the current document as a file. When called, it triggers a browser download of the document.\n\n## When to Use\n\n- The user asks to **download, export, or save** their document as a file\n- The user wants a **PDF or image** copy of their work\n- Examples: "Download this as a PDF", "Export my document", "Save this as a PNG"\n\n## When NOT to Use\n\n- The user wants to **print**\n- The user wants to **share** the document with others (different workflow)\n- The user wants to **save changes** (changes are auto-saved)\n\n## Important Notes\n\n- Triggers an **immediate browser download** — the user will see a file download in their browser\n- The download includes **all pages** in the document'};var UcOyk={zg:Ucxd.gaa,Bl:!0,description:"## Role\n\nSearches for available product features and shows the user clickable buttons to activate them.\n\n## When to Use\n- The user asks you to do something in the product and no other tool can accomplish it directly\n- The user is looking for a specific feature, setting, or capability\n- Use this BEFORE HelpCenterFallback when the request is about a product feature (not a conceptual question)\n\n## When NOT to Use\n- You have a more specific tool that directly accomplishes the user's request (e.g., use GenerateDiagram for diagram creation)\n- The user is asking a conceptual question about how something works (use HelpCenterFallback instead)\n\n## How to use\n- Each query of `queries` is a fuzzy search that should be treated like a search box\n- It will return buttons, toggles, and menu items\n- Keep queries short; longer queries tend to fuzzy match on fewer results\n- Try to guess at what the feature might actually be called, as exact matches will be more likely to succeed\n- The user may request multiple things, in which case include several searches for each thing",
Fga:i18n.get("ai-tool-loading-searching-features")};var UcPyk={zg:Ucxd.Tyc,Bl:!0,description:"## Role\n\nThis is your primary way to *read* the canvas or document. It retrieves and filters context from the document, extracting only the items, properties, or entire diagrams that are relevant to the request.\n\n**IMPORTANT:** This tool is *not* for generating summaries or interpretations. It solely filters and returns raw context with no added commentary.\n\n## How It Works\n\n- Searches across the **entire document** for items matching criteria (e.g., by color, tags, text alignment, shape type, notes)\n- Can return **specific items** along with only the properties that were requested\n- Can declare an **entire diagram** as relevant when every part of it matches\n- Use **plain language** in selectionCriteria — the tool translates your instructions into filters internally\n\nThink of this as telling the assistant *what to pull out of the canvas so other tools can work with it*.",
Fga:i18n.get("ai-tool-loading-reading-canvas")};var UcQyk={zg:Ucxd.zVf,Bl:!0,description:"## Role\n\nThis tool finds an available (non-overlapping) rectangular area on the current page of the canvas. Given a desired width and height and a position to search near, it returns the top-left coordinates of a clear area as close to that position as possible.\n\n## When to Use\n\n- **Before generating a new diagram** when other content already exists on the canvas, to avoid overlapping existing diagrams.\n- **When placing multiple diagrams** on the same page — call this tool for each subsequent diagram to find a clear area near the previous one.\n- **When the user asks to add content** near a specific location but you need to avoid collisions with existing blocks.\n\n## When NOT to Use\n\n- When the canvas is empty — just place content wherever makes sense.\n- When editing existing blocks — use *EditItem* instead.\n- When you only need to read what is on the canvas — use *CanvasQuery*.\n\n## How It Works\n\nThe tool searches outward from the specified (NearX, NearY) position to find the closest rectangular area of the requested size that does not overlap any existing canvas items. A margin is applied around existing items to ensure spacing. You can optionally specify a preferred direction to search in.\n"};var UcRyk={zg:Ucxd.Xyc,Bl:!1,description:'## Role\n\nGenerates ideas and adds them to the canvas as a **new grid of sticky notes**.\n\n## What This Tool Does\n\n- Creates a **fresh set of ideas** as individual sticky notes arranged in a grid\n- Can generate ideas based on a **user prompt** or **selected items** on the canvas\n- Output is always **sticky notes**, not diagram nodes or connected shapes\n- Defaults to 9 ideas; if the user requests a different number, convey that in the prompt\n\n## When to Use\n\n- User wants to **brainstorm ideas as sticky notes**\n- Creating a **new collection of ideas** independent of existing diagram structures\n- User explicitly asks for **sticky notes or a brainstorming grid**\n\n## When NOT to Use\n\n- **Do not use** if the user wants to add content to an **existing diagram** (flowchart, mindmap, ERD, etc.)\n- If the user has a mindmap and asks to "add ideas to the mindmap" → use *Generate Diagram* instead (they want to edit the diagram structure, not create sticky notes)\n- If the user mentions **editing, updating, expanding, or adding** to an existing diagram → use *Generate Diagram* regardless of words like "ideas" or "brainstorm"\n- If there is any **existing diagram** on the canvas that the user is referencing → default to *Generate Diagram*\n\n## Key Principle\n\nWords like "ideas" or "brainstorm" do **not** automatically mean this tool. Check context:\n- **Existing diagram** being edited? → Use *Generate Diagram*\n- **New standalone sticky notes**? → Use *this tool*\n',
Fga:i18n.get("ai-tool-loading-generating-ideas")};var UcSyk={zg:Ucxd.wzh,Bl:!0,description:["## Role\n\nRetrieves every screen-capture frame that falls inside one or more time windows of the active\nrecording so the assistant can batch-import images aligned with what was being said in the\ntranscript and choose the most informative frame(s) itself.\n\n## Capabilities\n\n- **Window-based retrieval** — returns every frame whose timestamp lies inside the inclusive\n  `[startSeconds, endSeconds]` interval of each supplied range\n- **Batch retrieval** — multiple ranges can be supplied in one call; results are concatenated in\n  the order the ranges were requested\n\n## Parameters\n\n- **ranges** — array of `{startSeconds, endSeconds}` time windows (in seconds, relative to the\n  start of the recording, excluding paused time). Pull the values from the transcript.\n\n**Window sizing:** Strongly prefer **short windows of 1-3 seconds** that yield a handful of\nframes. Long windows (more than 5 seconds) return many redundant frames, dilute the signal, and\nwaste tokens — split the moment into multiple short ranges instead of one wide one.\n\n## When to Use\n\n- The conversation contains a timestamped transcript and you need the visuals around specific\n  moments\n- You are producing a process diagram or summary that benefits from selective frames rather than\n  the full frame set — let the tool return all frames inside the window so you can pick the best\n  one(s) yourself\n\n## When NOT to Use\n\n- There is no recording associated with this conversation\n- A snapshot of the current canvas is needed — use *GetScreenshot* instead"]};var UcTyk={zg:Ucxd.fTe,Bl:!0,description:'## Role\n\nRetrieves the available line connection points for one or more blocks on the canvas. Connection points are the specific positions where lines can attach to a shape.\n\n## When to Use\n\n- Before creating or editing lines with `AddLine` or `EditLine` when connecting to ERD entity shapes or other shapes with dynamic, per-field connection points\n- When you need to know exactly where lines can attach to a shape (e.g., which side, which row/field)\n- When connecting to shapes that have more than the standard 4 connection points (top, bottom, left, right)\n\n## What It Returns\n\nFor each block, returns an array of connection points with:\n- `x` / `y`: Normalized coordinates (0.0–1.0) that can be passed directly as `LinkX` / `LinkY` to `AddLine` or `EditLine`\n- `description`: Human-readable description of what the point connects to (e.g., "left: user_id (field 2)")\n\n## Standard Shapes\n\nMost shapes have 4 connection points at the midpoints of each edge. You do not need to call this tool for standard shapes — just use `LinkX=0`/`LinkY=0.5` (left), `LinkX=1`/`LinkY=0.5` (right), `LinkX=0.5`/`LinkY=0` (top), `LinkX=0.5`/`LinkY=1` (bottom).\n\n## ERD Entities\n\nERD entity shapes have dynamic connection points — one pair (left + right) per field/row. Use this tool to discover the exact `LinkY` value for each field before creating lines.'};var UcUyk={zg:Ucxd.uWf,Bl:!0,description:"This tool returns partial JSON schemas for each requested resource type in a semantic dataset.\nSchemas describe the shape of the data — which fields are available, their types, and how data points relate to each other.\nUse schemas to understand what fields you can filter or query on before calling QuerySemanticResources.\n\nThe returned schemas are filtered to include only the fields relevant to your schemasPrompt.\nThis keeps context concise for large resource types.\nIf you need fields that are not in the partial schema, call this tool again with a broader schemasPrompt.\n\n## When to Use\n- After knowing which resource types are relevant to the user's question, fetch their schemas to understand the available fields\n- After using QuerySemanticResourceTypes to find exact resource type names\n- Use this before forming a QuerySemanticResources call when you need to know what data is available\n\n## When NOT to Use\n- Do not fetch all resource type schemas at once — only request schemas for the types relevant to the user's question\n- Skip this call if you already know the schema for the resource types you need\n\n## Parameters\n- datasetId (required): The ID of the semantic dataset containing the resource types.\n- resourceTypes (required): An array of resource type names to fetch schemas for. These must match exactly the return values of QuerySemanticResourceTypes.\n- schemasPrompt (required): A description of what information you need from the schemas. The more specific your prompt, the more focused the returned schema will be.\n\n## Output\nA partial JSON object mapping each requested resource type to its filtered JSON schema.\nOnly the fields relevant to your schemasPrompt are included.\nIf a schema is not found for a particular resource type, that will be indicated in the result."};var UcVyk={zg:Ucxd.wWf,Bl:!0,description:'This tool returns resource types from a specific semantic dataset that are relevant to what you are looking for.\n\n## Parameters\n- **datasetId**: The ID of the semantic dataset to query.\n- **resourceTypesPrompt**: A description of what resource types you are looking for. Only matching resource types from the dataset will be returned.\n\n## When to Use\n- Use this before fetching schemas or querying resources, to know what types are available and their names.\n\n## When NOT to Use\n- You already called this tool for the dataset and have the resource types you need\n\n## Output\nA JSON array of resource types as strings matching your prompt, e.g.:\n`["type1", "type2", "type3"]`\n\nIf the dataset is not found or has no matching resource types, the result will say so.'};var UcWyk={zg:Ucxd.iTe,Bl:!0,description:['## Role\n\nCaptures a visual screenshot of the document/canvas for vision-based analysis. Use this tool when you need to understand visual properties that are not captured by text-based tools like FilterCanvas.\n\n## Capabilities\n\n- **Visual layout** and spatial relationships between shapes\n- **Colors, sizes, and positioning** of elements\n- **Overall diagram structure** and organization\n- **Alignment and spacing** issues\n\n## Parameters\n\n- **captureScope** — What to capture (*Viewport*, *FullPage*, or *Selection*)\n- **includeBackground** — Whether to include the page background\n\n## When to Use\n\n- User asks about **visual appearance** ("What does this look like?")\n- User asks about **layout** ("Are these aligned?")\n- User asks about **colors or styling** ("What color is this shape?")\n- You need to **verify spatial relationships** before making changes\n- You want to **understand visual context** before answering questions\n\n## When NOT to Use\n\n- For **text content analysis** — use FilterCanvas instead\n- For **semantic structure** — use FilterCanvas instead\n- When shape properties are **already known** from previous tools\n\n## Example Scenarios\n\n- "Show me what the canvas looks like" → Use GetScreenshot with *Viewport* scope\n- "Are these shapes aligned properly?" → Use GetScreenshot then analyze positioning\n- "What\'s the layout of this section?" → Use GetScreenshot to see spatial arrangement']};var UcXyk={zg:Ucxd.yWf,Bl:!0,Fga:i18n.get("ai-agent-get-semantic-data-agent-for-query-loading"),description:'This tool analyzes the user\'s query against available semantic data agents and datasets in the document to recommend the most relevant agent to switch to.\n\n## When to Use\n- The user asks about data in the document (e.g., "show me my EC2 instances", "what resources are linked here")\n- The user\'s request relates to a domain that may have a linked semantic data agent (e.g., AWS, Azure, GCP)\n- Before switching to a semantic data agent — call this first to confirm which agent and datasets are relevant\n\n## When NOT to Use\n- You are already inside a semantic data agent\n- The user\'s request is clearly unrelated to domain-specific data in the document\n\n## Output\nThe name of the recommended semantic data agent and the relevant dataset IDs, e.g.:\n`{ "recommendedAgentName": "aws_semantic_data_agent", "relevantDatasetIds": ["uuid-1", "uuid-2"] }`\n\nIf no semantic data agent is applicable to the user\'s query, the response will be say so and the reason.\n\n## After This Tool\n- If a recommendedAgentName is returned, use the Switch Agent tool to hand off to that agent.\n- If no data is linked or no agent is applicable, use MessageUser to inform the user in plain language. Do not use technical terms like "semantic data agent" or "dataset" — say something like "It looks like there\'s no AWS data linked to this document yet."'};var UcYyk={zg:Ucxd.AWf,Bl:!0,description:'This tool returns the semantic dataset IDs present in the current document for a specific semantic domain. Given a domain key, it returns an array of semantic dataset IDs of that domain type.\n\n## When to Use\n- You know the DomainType the user is referring to and need the dataset IDs for that domain\n- Use this tool to discover dataset IDs for a specific domain before acting on them\n\n## When NOT to Use\n- You already know the specific dataset IDs the user is referring to — avoid redundant calls\n\n## Output\nAn array of dataset ID strings for the given domain, e.g.:\n`["uuid-1", "uuid-2"]`\n\nIf the document has no semantic data for the given domain, the result will say so.'};var UcZyk={zg:Ucxd.BWf,Bl:!0,description:'This tool retrieves relation definitions that describe how resource types are structurally connected to each other in a dataset.\nEach relation has the form: { from: ResourceType, type: string, to: ResourceType }.\nUse this to understand data relationships before writing relational queries or constructing SPARQL queries.\n\n## When to Use\n- After you requested the available resource types in the dataset via GetResourceTypesForDataset\n- When you need to understand how resource types are connected before querying across multiple types\n- Before constructing a SPARQL query using QuerySemanticResourcesWithSparql\n- When the user asks about relationships or connections between data types\n\n## When NOT to Use\n- Do not use this tool to retrieve actual resource instances — use QuerySemanticResourcesWithSparql or QuerySemanticResources for that\n- Do not call this if you already know the relevant relation definitions from prior context in this session\n\n## Parameters\n- `resourceTypePairs`: Provide pairs of resource types to find all relations between those types.\n- `resourceTypes`: Provide a list of resource type names to find all relations where any of those types appear in the relation.\n- At least one of the two parameters must be provided. You can use both.\n\n## Considerations\n- When asked about the relationship between two specific resource types, always prefer providing those two types as a pair in `resourceTypePairs` to narrow down results and reduce context size, rather than providing them individually in `resourceTypes`.\n- Only use `resourceTypes` when you need to know all possible relations. This should be avoided as it may return a large amount of data.\n\n## Output\nA JSON object with the query as key and an array of relation definitions as value. Each relation definition has the form:\n```\n{\n    from: string; // the resource type the relation starts from\n    type: string; // the type of the relation\n    to: string; // the resource type the relation points to\n}\n```\n\nExample output:\n```\n{\n    "ResourceType1": [\n        { "from": "ResourceType1", "type": "has", "to": "ResourceType2" }\n    ],\n    "ResourceType2 <-> ResourceType1": [\n        { "from": "ResourceType2", "type": "is part of", "to": "ResourceType1" }\n    ],\n    "ResourceType3": "No relationships found for resource type ResourceType3",\n};\n```\n'};var Uc_yk={zg:Ucxd.cVc,Bl:!0,description:"## Role\n\nSearches Lucid help center articles to provide guidance when you cannot directly fulfill a user's request.\n\n## When to Use\n\n- **Always use this tool first** when the user is asking for something that you or another tool cannot do\n- When the user needs help with a Lucid feature or workflow outside your capabilities\n\n## Usage Guidelines\n\n- Provide a **single concise sentence** explaining that you cannot directly perform the requested action\n- The tool queries help center articles and constructs a response based on relevant results",
Fga:i18n.get("ai-tool-loading-searching-helpdesk")};var Uc0yk={zg:Ucxd.NYf,Bl:!0,nRb:!0,Fga:i18n.get("ai-tool-loading-searching-jira"),description:["## Role\nUse this tool to search for Jira issues using a JQL (Jira Query Language) query and return relevant information about the matching issues.\n\n## Capabilities\n- Execute JQL queries against the user's connected Jira instance\n- Return issue keys, summaries, statuses, assignees, priorities, and other fields\n- Validate that a JQL query returns the expected set of issues before using it for timeline creation\n\n## Usage Guidelines\n- Build the JQL query from details the user provides (project name, team, sprint, labels, etc.)\n- After receiving results, summarize what was found and confirm with the user that these are the correct issues\n- If the results don't match expectations, iterate on the JQL query — adjust filters, add or remove conditions\n- Keep queries focused: avoid overly broad queries that return hundreds of irrelevant issues\n\n## Limitations\n- Cannot modify Jira issues — this tool is read-only\n- Requires a valid Jira connection (authentication is triggered automatically if needed)\n- Results are limited to the fields available in the user's Jira instance"]};var Uc1yk={zg:Ucxd.VVe,Bl:!0,description:"## Role\nUse this tool to compute optimal X/Y positions for blocks in entity-relationship diagrams before placing them on the canvas.\n\n## When to Use\n- When creating an entity-relationship diagram (ERD) with tables/entities and their relationships\n- When connections between blocks are bidirectional and minimizing line crossings matters\n- When you want a clean layout optimized for readability of relationships\n\n## When NOT to Use\n- For directed flowcharts or process diagrams — use RecommendSugiyamaLayout instead\n- For simple grid arrangements with no connections — use RecommendGridLayout instead\n- For single blocks or very simple 2-3 block diagrams where manual placement is trivial\n\n## How to Use\n1. Plan all your blocks (assign each a unique ID and label) and connections\n2. Call this tool with the full list of blocks and connections\n3. The tool returns computed X/Y pixel coordinates for each block\n4. Use those coordinates to place or edit block positions on the canvas\n\n## Grid and Spacing\n- You can adjust spacing by providing a LayoutGrid parameter with custom block sizes and spacing.\n- If unsure or unspecified by the user, use the recommended default values.\n\n## Connections\n- Connections are treated as bidirectional for layout purposes\n- The algorithm optimizes to minimize line crossings between connected blocks"};var Uc2yk={zg:Ucxd.WVe,Bl:!0,description:"## Role\nUse this tool to compute X/Y positions for diagram blocks arranged in a uniform grid before placing them on the canvas.\n\n## When to Use\n- When arranging blocks in a grid pattern (e.g., comparison tables, card layouts, icon grids)\n- When the blocks have no directional connections or hierarchy\n- When you want evenly spaced rows and columns\n\n## When NOT to Use\n- When blocks have directed connections or flow — use RecommendSugiyamaLayout instead\n- For single blocks or 2-3 block diagrams where manual placement is trivial\n- When editing existing diagrams where blocks are already placed\n\n## How to Use\n1. Plan all your blocks (assign each a unique ID and label)\n2. Optionally specify the number of columns; if omitted, an approximately square grid is used\n3. Call this tool with the list of blocks\n4. The tool returns computed X/Y pixel coordinates for each block\n5. Use those coordinates to place or edit block positions on the canvas\n\n## Grid and Spacing\n- You can adjust spacing by providing a LayoutGrid parameter with custom block sizes and spacing.\n- If unsure or unspecified by the user, use the recommended default values.\n\n## Columns\n- Set the Columns parameter to control how many blocks appear per row\n- If omitted, the grid will be approximately square (e.g., 9 blocks → 3x3)"};var Uc3yk={zg:Ucxd.XVe,Bl:!0,description:'## Role\nUse this tool to compute optimal X/Y positions for diagram blocks before placing them on the canvas.\n\n## When to Use\n- Before placing blocks when creating a diagram with 4 or more connected blocks\n- When you want a clean, professional layout without manually computing coordinates\n\n## When NOT to Use\n- For single blocks or very simple 2-3 block diagrams where manual placement is trivial\n- When editing existing diagrams where blocks are already placed\n\n## How to Use\n1. Plan all your blocks (assign each a unique ID and label) and connections\n2. Call this tool with the full list of blocks and connections\n3. The tool returns computed X/Y pixel coordinates for each block\n4. Use those coordinates to place or edit block positions on the canvas\n\n## Grid and Spacing\n- You can adjust spacing by providing a LayoutGrid parameter with custom block sizes and spacing.\n- If unsure or unspecified by the user, use the recommended default values.\n\n## Direction\n- "horizontal" (default): left-to-right flow, best for flowcharts and process diagrams\n- "vertical": top-to-bottom flow, best for org charts and hierarchical diagrams\n\n## Handling Cycles\n- If the diagram has cycles, provide StartBlockId and/or EndBlockId to anchor the layout\n- StartBlockId places that block at the beginning (leftmost or topmost)\n- EndBlockId places that block at the end (rightmost or bottommost)'};var Uc4yk={zg:Ucxd.QUe,Bl:!1,description:"## Role\n\nReposition and/or rotate a single existing block on the canvas.\n\n## When to Use\n- Repositioning a block (absolute X/Y or relative DeltaX/DeltaY)\n- Rotating a block\n\n## Rules\n- Delta* fields take precedence over their absolute counterparts when both are provided.\n- To change a block's size, use ResizeBlock.\n- Emit one call per block. To move multiple blocks, emit multiple parallel tool calls."};var Uc5yk={zg:Ucxd.p3f,Bl:!0,description:"This tool retrieves actual semantic resources from a dataset, with optional filters to narrow the results.\nUse this as a fallback if QuerySemanticResourcesWithSparql is not available or returns no results.\n\n## When to Use\n- If you simply need to get a resource by name or id.\n- OR: you don't have access to QuerySemanticResourcesWithSparql\n- OR: After attempting unsuccessfully to use QuerySemanticResourcesWithSparql\n- After determining which resource types are relevant (via GetResourceTypesForDataset) and optionally understanding their schemas (via GetResourceSchemasForDataset)\n\n## When NOT to Use\n- Do not call without at least one filter — unfiltered queries on large datasets may return too many results and be unhelpful\n- Do not guess field names or filters without consulting the schema first\n\n## Warning\n- This tool enforces a result cap by default to prevent context bloating. If the cap is hit, the response will include a truncation warning instructing you to call the tool again with `bypassCap` set to `true` to retrieve the full result set.\n\n## Filters\n- `resourceTypes`: Required. Must include at least one resource type to filter results by.\n- `keyword`: Search resources by keyword against resource names\n- `relatedTo`: Find resources related to specific resources (provide their resource ids)\n- `bypassCap`: Set to `true` only after instructed by a truncation warning and you are sure you will need the full set of resources. Defaults to `false`.\n- Multiple filters can be combined\n\n## Output\nA filtered JSON array of matching semantic resources. Each resource preserves its id, name, and type, but only includes the data fields relevant to your `resourcesPrompt`. Results are partial — if you need additional fields later, call the tool again with an updated `resourcesPrompt`.\nIf the dataset is not found or no resources match, the result will say so."};var Uc6yk={zg:Ucxd.H3f,Bl:!0,description:"## Role\n\nReturns structured data fields (label, value, type, enum options) for the specified Lucid cards.\n\n## When to use\n\nUse this tool when you already have card IDs and need their structured data fields.\nCard IDs come from CanvasQuery, FilterCanvas, or the user's selection context.\n\n## When NOT to use\n\nDo NOT use this tool to find cards. Use CanvasQuery instead to search by text, color, shape type, or region.\n\n## Pagination\n\nResults are paginated. By default, up to 50 cards are returned per call.\nUse the Offset and Limit parameters to paginate through larger sets.\nThe response indicates when more results are available.\n\n## Output\n\nFor each card, returns:\n- A list of fields with: label (human-readable name), value, type (string/number/date/boolean/color/etc.), enum options if applicable, and locked status.\n- Integration info showing which external integration (e.g. jira_cloud, extension_api) the card is synced to."};var Uc7yk={zg:Ucxd.LDh,Bl:!0,Woc:!1,description:"**Remove Decisions from Process Context Frame Tool**\n\nRemoves one or more decisions from the process context frame on the document.\n\n**When to Use:**\n- When the user provides information that contradicts an existing decision in the context frame. Remove the conflicting decision, then call AddDecisionsToProcessContextFrame with the new decision.\n- When the user explicitly asks to remove a decision from the context frame.\n\n**When NOT to Use:**\n- When no decisions exist in the context frame.\n\n**Key Behaviors:**\n- Multiple decisions can be removed in a single call.\n- Can be called alongside other tools (not a terminator).\n"};var Uc8yk={zg:Ucxd.V3f,Bl:!0,description:'## Role\nOpens the unlock-access flow so the user can request unlock access flow.\nDepending on the user\'s state this either opens the request-edit-access dialog or triggers the license-request flow with a dialog.\n\n## When to use\nCall this tool when the user explicitly asks to request edit access, request a license, or unlock access to the document.\nExamples: "Request edit access", "Unlock access", "How do I get edit access?", "Request a license", "Can I get a license?"\n\n## Important\n- Only call this tool when the user has directly indicated they want to request access.\n- Do not call this tool proactively — wait for the user to ask.\n\n## After execution — how to respond\nThe tool result will tell you which flow was triggered. Use that to guide your MessageUser response:\n- **License request flow**: Tell the user the license request dialog has opened. Use language like "unlock access" or "request a license" — do NOT say "request edit access".\n- **Edit access request flow**: Tell the user the modal to request edit access from the document owner has opened.'};var Uc9yk={zg:Ucxd.eWe,Bl:!1,description:"## Role\n\nReroutes existing lines using Manhattan grid routing — snaps lines to proper block edges and produces clean elbow turning points.\n\n## Parameters\n- **`BlockIds`** — IDs of all blocks in the diagram. Used as routing obstacles; the router needs the full set to avoid routing lines through blocks they shouldn't cross. Always pass all blocks, not just the ones connected to the lines being rerouted.\n- **`LineIds`** (optional) — IDs of specific lines to reroute. Omit to reroute all lines connected to the blocks in `BlockIds`. Use this to limit changes after editing a single block or rewiring one line.\n\n## Limitations\n- **Cyclical lines skipped** — lines with cyclical shape cannot be routed and are excluded\n\n## Result\nReturns a `## Results` section with one bullet per outcome:\n- Count of line IDs successfully rerouted\n- All cyclical line IDs in a single bullet (if any)\n- Line IDs converted to elbow with their original shape (if any)"};var Uc$yk={zg:Ucxd.fWe,Bl:!1,description:"## Role\n\nResize a single block. Handles overall size via Width/Height (or DeltaWidth/DeltaHeight), and column widths / row heights for grid-resizable blocks (tables, ERD entities, swimlanes).\n\n## When to Use\n- Changing a block's overall width or height, absolutely or by a delta.\n- Widening or narrowing columns or adjusting row heights of a grid-structured block.\n\n## Rules\n- Width/Height are absolute pixel values; DeltaWidth/DeltaHeight are pixel changes. If both are supplied on the same axis the delta wins.\n- ColumnWidths and RowHeights are pixel arrays indexed left-to-right and top-to-bottom, and only apply to blocks that expose a resizable grid.\n- Emit one call per block. To resize multiple blocks, emit multiple parallel tool calls."};var Ucazk={zg:Ucxd.E6f,Bl:!1,description:'Applies a single named property value to a single shape.\n\n## When to Use\n- After calling ShapeDetails to retrieve the shape\'s ShapeSchema.\n- When setting a value that the schema describes as supported (card fields like `title` and `status`, or advanced properties exposed to AI).\n- Call this tool once per property; to set multiple properties on the same shape, issue multiple tool calls.\n\n## Input\n- `shapeId`: the ID of the shape to mutate.\n- `propertyName`: the name of the property to set. Must match a name declared in the shape\'s ShapeSchema.\n- `value`: the value to apply, encoded as a string.\n- `valueType`: tells the client how to coerce the string value — "string", "number", or "boolean".\n\n## Output\nA confirmation that the property was applied, or an error describing why it could not be.\n\n## Notes\n- This tool does not change geometry, position, or rotation — use EditItem for those.'};var Ucbzk={zg:Ucxd.GL,Bl:!0,description:'## Role\nOpens the share dialog so the user can copy a link or invite collaborators by email.\n\n## When to use\n- The user asks to share the document, get a link, send it to someone, or invite people.\n- Examples: "share this", "copy a link to this diagram", "send this to my team", "invite Alex to edit".'};var Ucczk={zg:Ucxd.EAa,Bl:!1,description:'## Role\n\nSorts, categorizes, or clusters objects on the canvas into named groups.\n\n## Capabilities\n\n- Takes a list of canvas objects, **makes a copy**, and sorts them into groups based on shared characteristics, relationships, or user-defined criteria\n- Can **identify patterns, similarities, or connections** between objects to create meaningful groupings\n- Does **not** move or modify the original objects — creates new copies organized into groups\n- Can **not** operate on diagrams, only standalone items\n\n## Usage Guidelines\n\n- **Always pass ItemIds** when the user has asked for specific items to be sorted\n  - e.g., if the user says "Sort the sticky notes based on priority", include the ItemIds of those sticky notes (identify them by reading the canvas)\n- If **no ItemIds** are provided, the tool attempts to sort the user\'s **selected items** — leave ItemIds blank if the user wants to sort the selection\n- If no ItemIds and no selection, the tool sorts **all canvas objects** — this should be rare, so try to provide ItemIds whenever possible\n\n## Important Warnings\n\n- If the user asks for **specific shapes** to be sorted, you **must** call FilterCanvas first to identify the ItemIds — failure to do so may result in sorting the wrong items\n- **Always read the canvas first**, unless the user just wants to summarize the selection',
Fga:i18n.get("ai-tool-loading-sorting-shapes")};var Ucdzk={zg:Ucxd.rXe,Bl:!1,description:"## Role\n\nGenerates structured canvas content using the Standard Import format and places it directly on the canvas.\n\n## When to Use\n\n- Create a **new board layout** from a text description\n- Generate **structured content** like retrospectives, sprint planning boards, brainstorming sessions, etc.\n- Set up a **board template** based on their described workflow\n- Create **organized layouts** with sticky notes, containers, or grouped content\n\n## How It Works\n\n- Takes a detailed text prompt describing the desired content\n- Generates the corresponding **document structure** using the Standard Import format and places it on the canvas\n- The prompt should include **all relevant context** since the tool cannot see the chat history or existing canvas content",
Fga:i18n.get("ai-tool-loading-importing-diagram-data")};var Ucezk={zg:Ucxd.d8f,nRb:!0,Bl:!1,Fga:i18n.get("ai-tool-loading-syncing-jira-to-dynamic-table"),description:["## Role\nUse this tool to import Jira issues onto an existing Lucid dynamic table and set up ongoing auto-sync between the table and Jira.\n\n## Prerequisites\n- The JQL query should have been validated using the JiraSearch tool to confirm it returns the expected issues.\n- A dynamic table must already exist — use the CreateDynamicTable tool or the CanvasQuery tool to get a dynamic table.\n- The user must be authenticated to Jira.\n\n## Capabilities\n- Imports Jira issues matching a JQL query as cards and places them onto a specific dynamic table\n- Configures ongoing auto-sync so new Jira issues matching the query automatically appear on the table\n- Updates the existing sync config if one is already configured on the table (e.g., to change the JQL query)\n\n## Usage Guidelines\n- Use the generatorId of an existing dynamic table on the canvas\n- Use the same JQL query that was validated with JiraSearch\n- Call this AFTER CreateDynamicTable has created the table (or after you have obtained a dynamic table ID using CanvasQuery)\n- If a sync config already exists on the table, this tool updates the JQL and re-syncs\n\n## Limitations\n- Does not create dynamic tables — use CreateDynamicTable for that\n- Does not change table settings like pivots or capacity planning — use EditDynamicTableMetadata for that\n- Requires a valid Jira connection"]};var Ucfzk={zg:Ucxd.e8f,Bl:!1,nRb:!0,Fga:i18n.get("ai-tool-loading-syncing-jira-to-timeline"),description:["## Role\nUse this tool to import Jira issues onto an existing Lucid timeline and set up ongoing auto-sync between the timeline and Jira.\n\n## Prerequisites\n- The JQL query should have been validated using the JiraSearch tool to confirm it returns the expected issues.\n- A timeline must already exist — use the CreateLucidTimeline tool first.\n- The user must be authenticated to Jira.\n\n## Capabilities\n- Imports Jira issues matching a JQL query as cards and places them onto a specific timeline\n- Configures ongoing auto-sync so new Jira issues matching the query automatically appear on the timeline\n\n## Usage Guidelines\n- Use the generatorId returned by the CreateLucidTimeline tool\n- Use the same JQL query that was validated with JiraSearch\n- Call this AFTER CreateLucidTimeline has created the timeline\n\n## Limitations\n- Does not create timelines — use CreateLucidTimeline for that\n- Requires a valid Jira connection"]};var Ucgzk=Ucvd.Zyc;var Uchzk={zg:Ucxd.Qvb,Bl:!1,description:'## Role\n\nCreates a visual board — a structured canvas layout — from natural language descriptions. A board is a visual workspace organized into **labeled sections (frames)**, each containing content such as **sticky notes, tables, and swimlanes**. Boards are ideal for any activity that benefits from **visual organization, categorization, or structured thinking** — not just software/agile contexts.\n\n## When to use this tool\nUse this tool when the user wants to:\n- Create a new board layout from a text description\n- Generate structured content like retrospectives, sprint planning boards, brainstorming sessions, etc.\n- Create or fill in a **table** (e.g., itinerary, comparison matrix, schedule, tracker)\n- Create a **roadmap** (e.g., project milestones, release plan)\n- Prepare a template-like workspace that participants can fill in, e.g., set up a SWOT analysis\n- Set up a board template based on their described workflow\n- Organized, structured brainstorming with labeled sections (e.g., "brainstorm pros and cons")\n\n## When NOT to use this tool\n- Connected diagrams like flowcharts or ERDs — use Generate Diagram instead\n- A single shape or sticky note — use Add Block or Generate Ideas instead\n- A flat list of brainstormed ideas without board structure (e.g., "brainstorm names for my project") — use Generate Ideas instead\n\n## After using this tool\nSummarize what was created (board title, frame names, structure). Do NOT restate the user\'s request.\n\n## How it works\nThe tool analyzes the user\'s request to determine what type of board they want to create, then generates the appropriate board structure and content.',
Fga:i18n.get("ai-tool-loading-generating-board")};var Ucizk={zg:Ucxd.C8f,Bl:!0,description:"## Role\n\nGives you a place to think out loud for document analysis, task planning, and complex reasoning. This tool returns no output — the value is in organizing your thoughts before acting.\n\n## Usage\n\nAlways include ThinkAloud **alongside** your first batch of action tools in the same wave — never call it in a separate wave by itself.\n\n## Planning Guidance\n\nWhen planning, explicitly identify:\n- Which operations are **independent** and can be batched in the current wave\n- Which operations have **data dependencies** (need IDs or state from current-wave tools) and must wait for the next wave"};var Ucjzk={zg:Ucxd.XUf,Bl:!0,description:'Converts the current diagram or selected items into Mermaid code.\n\n## Capabilities\n- Reads the diagram content and generates valid Mermaid syntax\n- Auto-detects the best mermaid diagram type (flowchart, classDiagram, erDiagram, sequenceDiagram, stateDiagram, mindmap, etc.)\n- Preserves labels, text content, and relationships from the diagram\n- Can export specific items by ID or the full page\n\n## When to use\n- When the user asks to export, convert, or generate Mermaid code from their diagram\n- When the user wants a text representation of their diagram in Mermaid format\n- When the user mentions "mermaid" in the context of exporting or converting\n\n## When NOT to use\n- When the user wants to import Mermaid code into a diagram (use StandardImport or GenerateDiagram instead)\n- When the user wants a summary or description of their diagram (use Summarize instead)\n\n## Selection behavior\n- If items are selected on the canvas, export those items without asking — do NOT prompt the user to confirm scope\n- If nothing is selected, attempt to export the current page; if that\'s not possible, ask which diagram to export\n\n## Tool Output\n- After this tool completes, the tool result will contain the generated Mermaid code.\n- You MUST use MessageUser to display the Mermaid code to the user exactly as it appears in the tool result. Do not modify, summarize, or omit any part of the code.\n- Include a brief message (e.g. "Here\'s the exported Mermaid code:") before the code block.',
Fga:i18n.get("ai-tool-loading-generating-mermaid")};var Uckzk={zg:Ucxd.oWf,Bl:!1,description:"Generates a diagram within the agent's semantic domain from a prompt using the domain's shape library.\n## When to Use\n        - When the user wants to create a diagram that incorporates live data from semantic datasets in the document\n        - Only after querying the semantic data (using GetResourceTypesForDataset, GetResourceSchemasForDataset, QuerySemanticResources, etc.) to understand what resources are available\n        - When the user's intent relates to the domain's architecture\n## When NOT to Use\n        - Before using query tools to understand the available data — always gather data context first\n        - For non-domain diagrams\n## Shape Library\n        - All shapes must use the domain's shape library only",
Fga:i18n.get("ai-tool-loading-generating-diagram")};var Uclzk={zg:Ucxd.rWf,Bl:!0,description:"This tool finds shapes on the canvas that are linked to semantic resources in a specific dataset, and returns their JSON representation.\n\n## When to Use\n- When the user asks about shapes on the canvas that are linked to semantic data — note: not all shapes are data-backed.\n- When you need shape IDs in order to act on (move, edit, select, etc) specific data-backed shapes\n- After querying resources via QuerySemanticResources, to find their corresponding shapes on the canvas\n\n## When NOT to Use\n- Do not use to query resources in the semantic dataset itself — use QuerySemanticResources for that\n- Do not use if you only need resource data without needing the shapes\n- Not all shapes in the domain are data-backed. If you need to find shapes that are NOT linked to semantic resources, use CanvasQuery instead\n\n## Filters\n- `resourceTypes`: Return only shapes linked to resources of these types\n- `resourceIds`: Return only shapes linked to these specific resource IDs\n- If provided together, both filters are applied (AND logic)\n- Filters are required to prevent excessive results. If no filters are provided, the tool will return an error instructing you to provide at least one filter.\n\n## Warning\n- This tool enforces a result cap by default to prevent context bloating. If the cap is hit, the response will include a truncation warning instructing you to call again with `bypassCap` set to `true`, only use this if you are certain you need the full set.\n\n## Output\nA JSON representation of the matching canvas shapes, in the same format returned by CanvasQuery."};var Ucmzk={zg:Ucxd.gTe,Fga:i18n.get("ai-tool-get-document-history-loading-text"),Bl:!0,description:"Returns the most recent document actions in chronological order.\n\nEach action has an `Action` field indicating its type and some additional fields depending on the type of the action.\n\nWhen to use:\n- To understand what the user was recently working on before their current request\n- To detect changes made outside your own tool calls (e.g. manual user edits between turns)\n- To verify whether a previous operation produced the expected result"};var Ucnzk={zg:Ucxd.Ksa,Bl:!1,Woc:!0,description:['## Role\nUse this tool to undo canvas actions when the user asks to go back, undo, revert, or ctrl+z their changes.\nThe tool will automatically display a confirmation dialog to the user — you do not need to ask for confirmation first.\n\n## When to Use\n- User says "undo", "go back", "revert", "ctrl+z", "undo that", "take that back", or similar\n- User expresses dissatisfaction with recent AI-made changes and wants them reversed\n- User asks to undo multiple steps (e.g. "undo the last 3 changes") — set Steps accordingly\n\n## Parameters\n- **Steps** (optional): Number of undo steps to revert. Omit or set to 1 for a single undo. Set to the number the user specifies for multi-step requests.\n\n## Limitations\n- Each step undoes one undo batch (one logical change)\n- If there is nothing to undo, the tool will inform the user']};var Ucozk={zg:Ucxd.fYe,Bl:!0,description:"## Role\n\nValidates the current state of the canvas and reports visual issues.\n\n## Checks Performed\n\n1. **Bounding box overlap**: Detects blocks that overlap each other. For containers, checks that child blocks are fully inside or fully outside — partial overlap is flagged.\n2. **Disconnected line endpoints**: Finds lines with endpoints that are not connected to any block or line (free-floating endpoints).\n3. **Line passes through block**: Finds lines that geometrically pass through a block they are not connected to.\n4. **Text overflow**: Finds blocks where text content exceeds the block's bounds.\n5. **Orphaned blocks**: Finds non-container blocks that have no line endpoints connected to them.\n6. **Inefficient connector routing**: Finds elbow lines that take unnecessarily indirect paths, detected via three checks: exits or enters a block from the wrong side (connector departs away from its target), more than 3 direction changes, or a path length exceeding 2× the straight-line distance between endpoints.\n\n## When to Use\n\n- After generating or editing a diagram, call this tool to verify the visual quality of your changes before presenting the result to the user.\n- When the user asks you to check or fix layout issues.\n- *ValidateCanvas* runs after mutation tools within the same wave, so you can include it in the same wave as your final mutations — no need to call it in a separate wave.\n\n## Parameters\n\n- **ItemIds** (optional): Specific item IDs to validate. If omitted, validates all blocks and lines in the document.\n\n## Output\n\nReturns a list of issues found.\n\nEnsure any reported issues were intentional.  If any issues are not intentional, fix them before ending the execution loop or messaging the user.\n"};var Ucpzk={zg:Ucxd.wYe,Bl:!1,description:"## Role\n\nCreates a container around existing blocks on the canvas.\n\n## When to Use\n\n- When blocks need to be grouped into a container\n- Use assisted layout (default) when blocks should be arranged in a grid\n- Use non-assisted layout when blocks should keep their current positions\n\n## Constraints\n\n- Only block IDs are valid; line IDs and nonexistent IDs are skipped with error messages\n- When using assisted layout, blocks **cannot already be** in an assisted layout container"};var Ucqzk,Ucrzk=Ucqzk=class{constructor(a){this.Zrn=a.Zrn;this.FPn=a.FPn}toJSON(){return Ucqzk.Ta(this)}};Ucrzk=Ucqzk=__decorate([Uck({Zrn:["BreakGlassKey",Ucj(Uccsk)],FPn:["DevPublicKey",Ucj(Ucl)]}),__metadata("design:paramtypes",[Object])],Ucrzk);var Ucszk,Uctzk=Ucszk=class{constructor(a){this.detail=a.detail;this.ECd=a.ECd;this.value=a.value}toJSON(){return Ucszk.Ta(this)}};Uctzk=Ucszk=__decorate([Uck({ECd:["FeatureId",Ucl],detail:["Detail",Ucl],value:["Value",UcId(Ucl,()=>"")]}),__metadata("design:paramtypes",[Object])],Uctzk);var Ucuzk,Ucvzk=Ucuzk=class{constructor(a){this.qyb=a.qyb;this.value=a.value}toJSON(){return Ucuzk.Ta(this)}};Ucvzk=Ucuzk=__decorate([Uck({qyb:["Customization",Ucjsk],value:["Value",Ucl]}),__metadata("design:paramtypes",[Object])],Ucvzk);var Ucwzk,Ucxzk={TZ:"create_visual_activity"};const Ucyzk=Ucbd(Ucxzk);var UcAzk=Ucwzk=class{constructor(a){this.description=a.description;this.value=a.value}toJSON(){return Uczzk.Ta(this)}static get TZ(){return Ucwzk.Ua({Value:"create_visual_activity",Description:"This tool creates a visual activity — a specific interactive container type on the canvas that holds\n    draggable items. Visual activities support multiple layout types (freeform, categorization, axes, matrix, sliders)\n    for collaborative exercises.\n\n## When to Use\n- User explicitly asks for a 'visual activity', 'interactive exercise', 'drag and drop activity', or similar\n- User wants to create a categorization activity with labeled columns and an options bank\n- User wants an interactive ranking or plotting activity or exercises along axes or quadrants\n- User wants individual sliders for rating multiple items\n\n## When NOT to Use\n- User just wants static shapes or sticky notes on the canvas (use CreateBlock instead)\n- User wants a diagram or flowchart (use GenerateDiagram instead)\n- User wants to sort or cluster existing items on the canvas (use SortItems instead)\n- User wants to modify an existing visual activity (not supported, ask if the user wants to generate a new one incorporating changes)\n\n## Important Notes\n- Each item becomes a draggable sticky note inside the activity\n- The activity auto-sizes based on the number of items"})}static get values(){return[Ucwzk.TZ]}};
