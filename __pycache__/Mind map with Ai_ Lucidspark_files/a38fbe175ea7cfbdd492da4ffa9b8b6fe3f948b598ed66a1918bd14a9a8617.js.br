i18n.setData(
    JSON.parse(
        "{\"billing-info-months-april\":\"04 - April\",\"billing-info-months-august\":\"08 - August\",\"billing-info-months-december\":\"12 - December\",\"billing-info-months-february\":\"02 - February\",\"billing-info-months-january\":\"01 - January\",\"billing-info-months-july\":\"07 - July\",\"billing-info-months-june\":\"06 - June\",\"billing-info-months-march\":\"03 - March\",\"billing-info-months-may\":\"05 - May\",\"billing-info-months-november\":\"11 - November\",\"billing-info-months-october\":\"10 - October\",\"billing-info-months-september\":\"09 - September\",\"billing-info-states-AK\":\"Alaska\",\"billing-info-states-AL\":\"Alabama\",\"billing-info-states-AR\":\"Arizona\",\"billing-info-states-AZ\":\"Arkansas\",\"billing-info-states-CA\":\"California\",\"billing-info-states-CO\":\"Colorado\",\"billing-info-states-CT\":\"Connecticut\",\"billing-info-states-DE\":\"Delaware\",\"billing-info-states-FL\":\"Florida\",\"billing-info-states-GA\":\"Georgia\",\"billing-info-states-HI\":\"Hawaii\",\"billing-info-states-IA\":\"Iowa\",\"billing-info-states-ID\":\"Idaho\",\"billing-info-states-IL\":\"Illinois\",\"billing-info-states-IN\":\"Indiana\",\"billing-info-states-KS\":\"Kansas\",\"billing-info-states-KY\":\"Kentucky\",\"billing-info-states-LA\":\"Louisiana\",\"billing-info-states-MA\":\"Massachusetts\",\"billing-info-states-MD\":\"Maryland\",\"billing-info-states-ME\":\"Maine\",\"billing-info-states-MI\":\"Michigan\",\"billing-info-states-MN\":\"Minnesota\",\"billing-info-states-MO\":\"Missouri\",\"billing-info-states-MS\":\"Mississippi\",\"billing-info-states-MT\":\"Montana\",\"billing-info-states-NC\":\"North Carolina\",\"billing-info-states-ND\":\"North Dakota\",\"billing-info-states-NE\":\"Nebraska\",\"billing-info-states-NH\":\"New Hampshire\",\"billing-info-states-NJ\":\"New Jersey\",\"billing-info-states-NM\":\"New Mexico\",\"billing-info-states-NV\":\"Nevada\",\"billing-info-states-NY\":\"New York\",\"billing-info-states-OH\":\"Ohio\",\"billing-info-states-OK\":\"Oklahoma\",\"billing-info-states-OR\":\"Oregon\",\"billing-info-states-PA\":\"Pennsylvania\",\"billing-info-states-RI\":\"Rhode Island\",\"billing-info-states-SC\":\"South Carolina\",\"billing-info-states-SD\":\"South Dakota\",\"billing-info-states-TN\":\"Tennessee\",\"billing-info-states-TX\":\"Texas\",\"billing-info-states-UT\":\"Utah\",\"billing-info-states-VA\":\"Vermont\",\"billing-info-states-VT\":\"Virginia\",\"billing-info-states-WA\":\"Washington\",\"billing-info-states-WI\":\"Wisconsin\",\"billing-info-states-WV\":\"West Virginia\",\"billing-info-states-WY\":\"Wyoming\",\"canonical-document-input-parameters-backlog\":\"Backlog\",\"canonical-document-input-parameters-daily-standup\":\"Daily standup\",\"canonical-document-input-parameters-sprint-planning\":\"Sprint planning\",\"code-block-theme-dark\":\"Dark\",\"code-block-theme-light\":\"Light\",\"document-presets-backlog-default-axis-assignee-v2\":\"Assignee {count}\",\"document-presets-backlog-default-axis-sprint-v2\":\"Sprint {count}\",\"document-presets-backlog-default-axis-status-v2\":\"Status {count}\",\"educational-walkthrough-breakout-boards-heading-1\":\"Enhance collaboration with large groups\",\"educational-walkthrough-breakout-boards-heading-2\":\"Set up your breakout board\",\"educational-walkthrough-breakout-boards-heading-3\":\"Save time by duplicating boards\",\"educational-walkthrough-breakout-boards-heading-4\":\"Easily facilitate breakout sessions\",\"educational-walkthrough-breakout-boards-heading-5\":\"Seamlessly move content between boards\",\"educational-walkthrough-breakout-boards-subtitle-1\":\"Create breakout boards to allow large groups to collaborate in smaller groups and improve creativity and engagement.\",\"educational-walkthrough-breakout-boards-subtitle-2\":\"Set up a breakout board just as you would a normal board. You can access all of your boards anytime from the breakout board panel.\",\"educational-walkthrough-breakout-boards-subtitle-3\":\"Duplicate boards once or multiple times to help save time while setting up a team workshop.\",\"educational-walkthrough-breakout-boards-subtitle-4\":\"Quickly start breakouts for all participants and call everyone back to the main board once complete.\",\"educational-walkthrough-breakout-boards-subtitle-5\":\"Move content from your main board to a breakout—and back again—based on the team's need.\",\"educational-walkthrough-dependency-mapping-heading-1\":\"Visualize dependencies with card integrations\",\"educational-walkthrough-dependency-mapping-heading-2-v2\":\"Import missing tasks or work items\",\"educational-walkthrough-dependency-mapping-heading-3\":\"Easily create new dependencies\",\"educational-walkthrough-dependency-mapping-heading-4\":\"Toggle and filter dependencies across your board\",\"educational-walkthrough-dependency-mapping-subtitle-1-v2\":\"Click on linked work items within integrated cards to view dependent relationships and better plan your team's work.\",\"educational-walkthrough-dependency-mapping-subtitle-2-v2\":\"See any linked tasks or work items and immediately import them to your board.\",\"educational-walkthrough-dependency-mapping-subtitle-3\":\"Connect integrated cards with lines to create new relationships between them.\",\"educational-walkthrough-dependency-mapping-subtitle-4\":\"Enhance your ability to plan and visualize your team's work by viewing all dependencies within a board. Show, filter, or hide those connections to customize your view.\",\"educational-walkthrough-dynamic-tables-heading-1\":\"Easily customize Dynamic Tables\",\"educational-walkthrough-dynamic-tables-heading-2\":\"Use Lucid Cards to add info about tasks\",\"educational-walkthrough-dynamic-tables-heading-3\":\"Create custom pivots for your table\",\"educational-walkthrough-dynamic-tables-heading-4\":\"Track progress and workload automatically\",\"educational-walkthrough-dynamic-tables-heading-5\":\"Add Dynamic Tables to any board\",\"educational-walkthrough-dynamic-tables-subtitle-1\":\"Rename, add, and drag additional columns or rows to suit your team's workflow.\",\"educational-walkthrough-dynamic-tables-subtitle-2\":\"Create new or drag existing cards (including Lucid Cards for Jira) to your table.\",\"educational-walkthrough-dynamic-tables-subtitle-3\":\"Automatically categorize items into custom rows and columns based on color, tags, assignee, status, and more.\",\"educational-walkthrough-dynamic-tables-subtitle-4\":\"If your cards have  story points, toggle on workload or progress trackers to streamline team planning.\",\"educational-walkthrough-dynamic-tables-subtitle-5\":\"Add a table to your boards from the Organizers tab in your toolbar.\",\"educational-walkthrough-timelines-heading-1\":\"Quickly customize your Timeline view\",\"educational-walkthrough-timelines-heading-2\":\"Use Lucid Cards to begin planning\",\"educational-walkthrough-timelines-heading-3\":\"Edit Lucid Cards on the Timeline\",\"educational-walkthrough-timelines-heading-4\":\"Track progress and workload automatically\",\"educational-walkthrough-timelines-heading-5\":\"Now add a Timeline to any board\",\"educational-walkthrough-timelines-subtitle-1\":\"Select the unit and period of time to get your Timeline set up.\",\"educational-walkthrough-timelines-subtitle-2\":\"Double click on the Timeline to create new or drag existing cards (including Lucid Cards for Jira) to your Timeline.\",\"educational-walkthrough-timelines-subtitle-3\":\"Cards with dates will be formatted automatically. You can drag cards to change their dates or reorder them.\",\"educational-walkthrough-timelines-subtitle-4\":\"If your cards have story points and a status, toggle on the progress tracker to streamline team planning.\",\"educational-walkthrough-timelines-subtitle-5\":\"Add a Timeline to your boards from the Organizers tab in your toolbar.\",\"educational-walkthrough-visual-activities-heading-1\":\"Customize your Visual Activities\",\"educational-walkthrough-visual-activities-heading-2\":\"Make your activity interactive\",\"educational-walkthrough-visual-activities-heading-3\":\"Confirm and save your activity\",\"educational-walkthrough-visual-activities-heading-4\":\"Begin the activity with your team\",\"educational-walkthrough-visual-activities-heading-5\":\"Discover new activities or create your own\",\"educational-walkthrough-visual-activities-subtitle-1\":\"Edit or add text and other shapes to include labels, instructions, or imagery.\",\"educational-walkthrough-visual-activities-subtitle-2\":\"Drag objects into the options bank or toggle them as \\\"draggable\\\" to make them interactive.\",\"educational-walkthrough-visual-activities-subtitle-3\":\"Preview an activity to test it, then save when the activity is complete.\",\"educational-walkthrough-visual-activities-subtitle-4\":\"Teammates can begin the activity on their own or you can choose to begin the activity for everyone on your board.\",\"educational-walkthrough-visual-activities-subtitle-5\":\"Get started faster with a Visual Activities template from the toolbar or create your own activity from scratch.\",\"educational-walkthrough-whiteboarding-basics-heading-1\":\"Add your ideas\",\"educational-walkthrough-whiteboarding-basics-heading-2\":\"Customize your content\",\"educational-walkthrough-whiteboarding-basics-heading-3\":\"Draw out connections\",\"educational-walkthrough-whiteboarding-basics-heading-4\":\"Organize and navigate your canvas\",\"educational-walkthrough-whiteboarding-basics-heading-5\":\"Collaborate with others\",\"educational-walkthrough-whiteboarding-basics-subtitle-1\":\"Double-click anywhere on the canvas to quickly add a sticky note. Insert images, text, and links for additional context.\",\"educational-walkthrough-whiteboarding-basics-subtitle-2\":\"Select any object on the canvas to bring up the contextual menu. Change the color or format the shape.\",\"educational-walkthrough-whiteboarding-basics-subtitle-3\":\"Connect ideas by dragging out a line from a purple dot on the edge of an object. For freehand annotation, press <w0></w0> for the pen tool or <w1></w1> for laser pointer.\",\"educational-walkthrough-whiteboarding-basics-subtitle-4\":\"Easily add structure to your canvas by wrapping content in Frames. Use the Table of Contents to quickly navigate to different sections of the board.\",\"educational-walkthrough-whiteboarding-basics-subtitle-5\":\"Invite others to join you on the board by clicking the \\\"Share\\\" button. Watch the sparks fly as you all add content, make edits, and work together in real time!\",\"in-workspace-onboarding-button-maybe-later\":\"Maybe later\",\"in-workspace-onboarding-button-next\":\"Next\",\"in-workspace-onboarding-button-previous\":\"Previous\",\"invitation-modal-confirm-msg\":\"Teammates invited\",\"invitation-modal-invite-msg\":\"Hey, will you brainstorm with me on this board?\",\"invitation-modal-invite-title-v2\":\"Invite teammates to collaborate with you for free\",\"invitation-modal-project-name\":\"Team brainstorm\",\"invitation-modal-project-name-prompt-v2\":\"Name this board\",\"invitation-modal-subtitle-v2\":\"{product} is <w0>best used with others.</w0>\",\"invitation-modal-title-v2\":\"Invite Teammates\",\"learning-center-quick-diagramming-interactive-walkthrough\":\"Quick diagramming\",\"learning-center-quick-diagramming-interactive-walkthrough-step-1-body\":\"Learn how to build your diagrams faster with some of our favorite quick diagramming tips.\",\"learning-center-quick-diagramming-interactive-walkthrough-step-2-body\":\"If you already know the process you need to diagram, let Lucid's AI capabilities generate a diagram for you.\",\"learning-center-quick-diagramming-interactive-walkthrough-step-2-heading\":\"Let Lucid start your diagram\",\"learning-center-quick-diagramming-interactive-walkthrough-step-3-body\":\"If you are building a process from scratch, drag and drop a process shape onto the canvas. Then, click a shape node to instantly add and connect additional shapes to keep your thoughts moving.\",\"learning-center-quick-diagramming-interactive-walkthrough-step-3-heading\":\"Flow as you go\",\"learning-center-quick-diagramming-interactive-walkthrough-step-4-body\":\"Click the change shape icon to modify shape type, improving context and adding meaning to your diagram.\",\"learning-center-quick-diagramming-interactive-walkthrough-step-4-heading\":\"Shape shifting\",\"learning-center-quick-diagramming-interactive-walkthrough-step-5-body\":\"Quickly customize shapes by applying theme styles. Any changes you make to your theme will be automatically applied to all styled shapes within your document.\",\"learning-center-quick-diagramming-interactive-walkthrough-step-5-heading\":\"Theme styles\",\"learning-center-swimlanes-interactive-walkthrough\":\"Swimlanes\",\"learning-center-swimlanes-interactive-walkthrough-step-1-body\":\"Use swimlanes to visualize workflows, identify areas for improvement, and understand process responsibilities by function.\",\"learning-center-swimlanes-interactive-walkthrough-step-2-body\":\"Drag and drop a swimlane from the left hand panel. Double click on the swimlane you want to adjust, then right click to select actions.\",\"learning-center-swimlanes-interactive-walkthrough-step-2-heading\":\"Insert, remove, or move a swimlane\",\"learning-center-swimlanes-interactive-walkthrough-step-3-body\":\"For each team or phase, add relevant process steps and click to change shape types to add context to your diagram. Then, add or adjust lines to connect steps across the lanes.\",\"learning-center-swimlanes-interactive-walkthrough-step-3-heading\":\"Build your process\",\"learning-center-swimlanes-interactive-walkthrough-step-4-body\":\"Pull the edges of the swimlanes to expand them for more shapes.\",\"learning-center-swimlanes-interactive-walkthrough-step-4-heading\":\"Expand your swimlanes\",\"learning-center-swimlanes-interactive-walkthrough-step-5-body\":\"Use the right hand contextual panel to add color to your swimlane. You can also use the formatting bar to adjust shape colors, fonts, text size, and line thickness.\",\"learning-center-swimlanes-interactive-walkthrough-step-5-heading\":\"Customize your swimlanes\",\"option-bar-icon-sets-icon\":\"Icon\",\"persona-answer-use-case-agile-development-v2\":\"Agile development\",\"persona-answer-use-case-blank-v2\":\"Blank board\",\"persona-answer-use-case-brainstorming-and-ideation-v2\":\"Brainstorming and ideation\",\"persona-answer-use-case-meetings-and-workshops-v2\":\"Meetings and workshops\",\"persona-answer-use-case-research-and-design-v2\":\"Research and design\",\"persona-answer-use-case-strategy-and-planning-v2\":\"Strategy and planning\",\"spark-breakout-room-name\":\"Breakout {index}\",\"spark-breakout-room-name-default\":\"Unknown Breakout\",\"spark-onboarding-collaborate-description-v2\":\"Here’s a quick tutorial to dynamically collaborate in Lucidspark. Brainstorm together, vote on ideas, and gather feedback to bring your best ideas to life.\",\"spark-onboarding-collaborate-title\":\"Collaborate in Lucidspark\",\"spark-onboarding-communicate-description\":\"Keep everyone on the same page using @mentions and comments to solicit feedback, resolve questions, and call attention to specific ideas. You can even chat directly in Lucidspark.\",\"spark-onboarding-communicate-title\":\"Communicate with your team\",\"spark-onboarding-engagement-description\":\"<w0>See the board from your teammate’s perspective and follow along as they work.</w0><w1>Vote as a team to find the best solution.</w1>\",\"spark-onboarding-engagement-title\":\"Foster team engagement\",\"spark-onboarding-finish\":\"Finish\",\"spark-onboarding-highlight-description\":\"<w0>Highlight top ideas with freehand drawing.</w0><w1>Give real-time feedback with emojis, reactions, and comments.</w1>\",\"spark-onboarding-highlight-title\":\"Highlight your best work\",\"spark-onboarding-innovation-description\":\"Brainstorm as a team using sticky notes and other shapes. Double-click anywhere on the board to quickly add the most recent shape.\",\"spark-onboarding-innovation-title-v2\":\"Spark innovation\",\"spark-onboarding-maybe-later-v2\":\"Maybe later\",\"spark-onboarding-share-description\":\"See all of your boards and even create new ones right from your home page. Share your new boards with others to start collaborating.\",\"spark-onboarding-share-title\":\"Create and share boards\",\"user-invitation-pending\":\"Pending Invitation\"}"
    ),
    'en'
);