     vec2 segment = end - start;\n            float segmentLength = length(segment);\n\n            // 'normal' tells us which normal to use when we offset the vertex\n            // parallel/perpendicular later on.  For regular segments this is just the\n            // normal of the segment.  For joints, it depends on which side of the\n            // joint we're on.\n            vec2 normal = segment / segmentLength;\n\n            vPatternLengthAndOffset.x = segmentLength;\n\n            // Normals to use\n            // For joints, its the normal on each side of the joint:\n            //   start -> end, end -> next\n            // For regular segment, they're both the segment's normal\n            //   start -> end\n            vNormals = vec2[2](normal, normal);\n\n            // Counter-clockwise perpendicular to the normal\n            //    perp\n            //     ^\n            //     |\n            //     ----\x3e normal\n            vec2 perp = vec2(normal.y, -normal.x);\n\n            // This has zOffset in the lower 4 bits, lineCap in bits 4,5 and lineJoin in 6,7.\n            int zOffsetCapJoin = int(aFlags.z);\n\n            // For rectangles and circles:\n            //   prev = width/2, height/2 (radius, radius for circles)\n            //   start = center of shape\n            //   end = corner radii top left, top right\n            //   next = corner radii bottom right, bottom left\n            if (aFlags.y == 3.0 || aFlags.y == 2.0) {\n                vFillType = 4.0;\n                vCenter = start; // Center of rectangle/circle\n                vEndOrHalfWidthHeight = prev; // width/2, height/2 (both are radius for circles)\n\n                // We can only round at most half the width/height\n                vCornerRadii = min(aCornerRadii, min(prev.x, prev.y));\n                vVertexPosition = start + offset * (prev + aliasWidth);\n            } else {\n                // Assume a radius for rounded linecaps or rounded linejoins\n                vCornerRadii[0] = halfWidth;\n\n                // Everything but simple shapes (circles and rectangles) ends up here.\n                int lineCap = (zOffsetCapJoin & 0x30) >> 4;\n\n                // A CapOnly quad sits at the end of an arc.\n                if (aFlags.y == 4.0) {\n                    vec2 lineCapInfo = capInfo[lineCap];\n                    float capLength = halfWidth * lineCapInfo.x;\n                    vVertexPosition = start;\n                    vCenter = vVertexPosition;\n                    vVertexPosition += (aliasWidth * sideOffset * perp);\n                    vVertexPosition -= (capLength * isStart * normal);\n                    vFillType = lineCapInfo.y;\n                } else {\n                    // Extract the bits for rounding\n                    bool isJoint = ((flags & 32) != 0);\n                    float roundStart = ((flags & 8) != 0) ? 1.0 : 0.0;\n                    float roundEnd = ((flags & 16) != 0) ? 1.0 : 0.0;\n\n                    // Rounding in pixels\n                    float rounding = aWidthRounding.y;\n                    if (roundStart + roundEnd == 0.0) {\n                        rounding = 0.0;\n                    }\n\n                    vFillType = 1.0;\n\n                    // Assume no rounding.  Non-joint vertices use this, too\n                    float roundLength = 0.0;\n\n                    if (isJoint) {\n                        vec2 nextSegment = next - end;\n                        float nextLength = length(nextSegment);\n\n                        roundLength = min(rounding, min(segmentLength, nextLength) / 2.0);\n                        // Set the 2nd normal in 'vNormal' to nextSegment's normal.\n                        vNormals[1] = nextSegment / nextLength;\n\n                        // Calculate the angle between 'segment', and 'nextSegment'.\n                        // dot(a,b) = |a||b|cos(x) or cos(x) = dot(a,b)/|a||b|\n                        float cos2x = dot(-segment, nex