g, determine the type of line joint\n                            // we want to use between segments.  (i.e., canvas 'lineJoin')\n                            if (lineJoin == 1) {\n                                // If the lineJoin is 'round', set the fill type to wedge\n                                vFillType = 3.0;\n                            } else if (lineJoin == 0) {\n                                float miterLimit = 10.0;  // Miter limit\n                                // If we exceed the miter limit, switch to 'bevel' line joints\n                                if (sinSquared < 1.0 / (miterLimit * miterLimit)) {\n                                    lineJoin = 2;\n                                }\n                            }\n                        }\n\n                        // The 'quad' we make for a joint looks like the region filled\n                        // with '*' below.  'Inner' and 'Outer' are the common\n                        // points to each triangle.\n                        //\n                        //                     (1)\n                        //   ---------------------------/  Outer (2)\n                        //                      |******/\n                        //            Inner (0) |*****/\n                        //                       ***/\n                        //   -------------/       */\n                        //               /         / (3)\n                        //              /         /\n                        //\n\n                        vec2 joint = joints[cornerIndex];\n                        normal = vNormals[int(joint.x)];\n                        perp = vec2(normal.y, -normal.x);\n\n                        float outer = (aFlags.y == 1.0) ? roundLength : aliasWidth / tan;\n\n                        // Offset to get to the edge including space for aliasing\n                        vec2 toEdge = aliasWidth * direction * perp;\n\n                        float isRounded = roundLength > 0.0 ? 1.0 : 0.0;\n\n                        vStart = end - roundLength * vNormals[0];\n                        vCenter = end - isRounded * roundLength * vNormals[0];\n                        vCenter += isRounded * vCornerRadii[0] * -direction * vec2(vNormals[0].y, -vNormals[0].x);\n\n                        if (cornerIndex == 0) { // Inner\n                            // Inner vertex.  Just move this if we're rounded\n                            vVertexPosition = end - isRounded * roundLength * normal;\n                            vVertexPosition += isRounded * vCornerRadii[0] * -direction * perp;\n                        } else if (cornerIndex == 2) { // Outer\n                            // All joint corners are treated the same other than beveled joints.\n                            if (roundLength == 0.0 && lineJoin == 2) {\n                                vec2 perpA = vec2(vNormals[0].y, -vNormals[0].x);\n                                vec2 perpB = vec2(vNormals[1].y, -vNormals[1].x);\n                                vec2 midpoint = direction * perpA + direction * perpB;\n                                vVertexPosition = end + (midpoint * aliasWidth / 2.0);\n                            } else {\n                                // If we're at a very small angle, 'tan' will be very small and\n                                // cause 'outer' to be very large.  Limit outer in that case.\n                                if (tan < 0.001) {\n                                    outer = lineWidth * 10.0;\n                                }\n                                vVertexPosition = end + outer * normal + toEdge;\n                            }\n                        } else {\n                            vVertexPosition = end - roundLength * sideOffset * normal + toEdge;\n                            vUseNext = joint.x;\n                        }\n                    } else {\n                        float capStart = ((flags & 2) != 0) ? 1.0 : 0.0;\n                        float capEnd = ((flags & 4) != 0) ? 1.0 : 0.0;\n\n                        // Regular (non-joint) line segments end up here.\n                        // Select 'start' or 'end' based on flags.\n                        vVertexPosition = isStart * start + isEnd * end;\n                        vVertexPosition += (aliasWidth * perp * sideOffset);\n                        vCenter = vVertexPosition;\n\n                        // Do we need to add any length at the start/end for a linecap?\n                        vec2 lineCapInfo = capInfo[lineCap];\n                        float capDirection = -capStart * isStart + capEnd * isEnd;\n                        float capLength = halfWidth * capDirection * lineCapInfo.x;\n                        vVertexPosition += (capLength * normal);\n\n                        float isRound = (lineCap == 1) ? 1.0 : 0.0;\n                        vFragmentFlags += isRound * capStart * 2.0;\n                        vFragmentFlags += isRound * capEnd * 4.0;\n\n                        // Move the 'start' further along the segment's normal to account\n                        // for any rounding from the previous joint.  Also shorten length\n                        // for dashing/dotting.\n                        vec2 prevSegment = start - prev;\n                        float prevLength = length(prevSegment);\n                        roundLength = roundStart * min(rounding, min(segmentLength, prevLength) / 2.0);\n                        vStart += roundLength * normal;\n                        vPatternLengthAndOffset.x -= roundLength;\n                        vVertexPosition += roundLength * normal * isStart;\n\n                        // Same but with 'end'\n                        vec2 nextSegment = next - end;\n                        float nextLength = length(nextSegment);\n                        roundLength = roundEnd * min(rounding, min(segmentLength, nextLength) / 2.0);\n                        vEndOrHalfWidthHeight -= roundLength * nor