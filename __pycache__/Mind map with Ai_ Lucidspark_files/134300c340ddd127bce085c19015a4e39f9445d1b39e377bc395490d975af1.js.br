    :root {
        color-scheme: light dark;
    }
    * {
        box-sizing: border-box;
    }
    body {
        margin: 0;
        padding: var(--strata-container-padding-standard, 16px);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--strata-background-primary, ${UcCTk});
        color: var(--strata-foreground-primary, ${UcDTk});
        display: flex;
        flex-direction: column;
        gap: var(--strata-gap-md, 8px);
        user-select: none;
        overflow: hidden;
    }
    header {
        display: flex;
        align-items: center;
        gap: var(--strata-gap-md, 8px);
    }
    .title {
        margin: 0;
        font-size: ${Ucvca["font-size"]};
        font-weight: ${Uctca["font-weight"]};
        line-height: ${Ucvca["line-height"]};
    }
    .beta-tag {
        display: inline-flex;
        align-items: center;
        padding: var(--strata-gap-xs, 2px) var(--strata-padding-sm, 8px);
        border-radius: var(--strata-radius-md, 8px);
        border: 2px solid var(--strata-foreground-secondary, ${UcETk});
        color: var(--strata-foreground-secondary, ${UcETk});
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.05em;
        flex-shrink: 0;
    }
    .status-group {
        display: flex;
        flex-direction: column;
        gap: var(--strata-gap-xs, 2px);
    }
    .status-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }
    .status-left {
        display: flex;
        align-items: center;
        gap: var(--strata-gap-md, 8px);
    }
    .recording-indicator {
        width: 10px;
        height: 10px;
        background: var(--strata-background-danger, ${UcJTk});
        border-radius: 50%;
        animation: pulse 1.5s ease-in-out infinite;
        flex-shrink: 0;
    }
    @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
    }
    .status-text {
        font-size: ${Ucvca["font-size"]};
        font-weight: ${Uctca["font-weight"]};
    }
    .status-right {
        display: flex;
        align-items: center;
        gap: var(--strata-gap-md, 8px);
    }
    .mic-icon {
        display: flex;
        align-items: center;
        color: var(--strata-foreground-secondary, ${UcETk});
    }
    .timer {
        font-size: ${Ucuca["font-size"]};
        font-weight: ${Uctca["font-weight"]};
        font-variant-numeric: tabular-nums;
    }
    .frame-count {
        margin: 0;
        font-size: 12px;
        color: var(--strata-foreground-secondary, ${UcETk});
    }
    .button-icon {
        display: flex;
        align-items: center;
    }
    .button-icon svg {
        width: 24px;
        height: 24px;
    }
    .pause-button {
        width: 100%;
        height: 32px;
        padding: 0 var(--strata-container-padding-standard, 16px);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--strata-gap-sm, 4px);
        margin-top: var(--strata-gap-md, 8px);
        border: 1px solid var(--strata-foreground-accent, ${UcHTk});
        border-radius: var(--strata-radius-md, 8px);
        background: transparent;
        color: var(--strata-foreground-accent, ${UcHTk});
        font-size: ${Ucvca["font-size"]};
        font-weight: ${Ucs2k["font-weight"]};
        font-family: inherit;
        cursor: pointer;
    }
    .pause-button:hover {
        background: var(--strata-background-accent, ${UcFTk});
        color: var(--strata-foreground-on-accent, ${UcITk});
    }
    .pause-button:focus-visible {
        outline: 2px solid var(--strata-border-focus, ${UcLTk});
        outline-offset: 2px;
    }
    .finish-button {
        width: 100%;
        height: 32px;
        padding: 0 var(--strata-container-padding-standard, 16px);
        border: none;
        border-radius: var(--strata-radius-md, 8px);
        background: var(--strata-background-accent, ${UcFTk});
        color: var(--strata-foreground-on-accent, ${UcITk});
        font-size: ${Ucvca["font-size"]};
        font-weight: ${Ucs2k["font-weight"]};
        font-family: inherit;
        cursor: pointer;
    }
    .finish-button:hover {
        background: var(--strata-background-accent-hover, ${UcGTk});
    }
    .finish-button:focus-visible {
        outline: 2px solid var(--strata-border-focus, ${UcLTk});
        outline-offset: 2px;
    }
    .strata-2-colors .pause-button {
        border-color: var(--strata-foreground-primary, ${UcDTk});
        color: var(--strata-foreground-primary, ${UcDTk});
    }
    .strata-2-colors .pause-button:hover {
        background: var(--strata-background-brand, ${UcMTk});
        color: var(--strata-foreground-on-brand, ${UcOTk});
    }
    .strata-2-colors .finish-button {
        background: var(--strata-background-brand, ${UcMTk});
        color: var(--strata-foreground-on-brand, ${UcOTk});
    }
    .strata-2-colors .finish-button:hover {
        background: var(--strata-background-brand-hover, ${UcNTk});
    }
